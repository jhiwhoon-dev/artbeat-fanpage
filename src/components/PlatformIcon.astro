---
// 심플한 라인 스타일 아이콘 (오픈소스 아이콘 세트 스타일). 완전히 동일한 공식 로고는 아니지만
// 각 플랫폼을 시각적으로 알아볼 수 있는 수준으로 제작했습니다.
interface Props {
  platform: string;
}
const { platform } = Astro.props;
const key = platform.toLowerCase();
---
{key === 'youtube' && (
  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect x="1.5" y="5.5" width="21" height="13" rx="4" stroke="currentColor" stroke-width="1.6"/>
    <path d="M10 9.2L15 12L10 14.8V9.2Z" fill="currentColor"/>
  </svg>
)}
{key === 'instagram' && (
  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect x="2.5" y="2.5" width="19" height="19" rx="5" stroke="currentColor" stroke-width="1.6"/>
    <circle cx="12" cy="12" r="4.3" stroke="currentColor" stroke-width="1.6"/>
    <circle cx="17.6" cy="6.4" r="1.1" fill="currentColor"/>
  </svg>
)}
{key === 'tiktok' && (
  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M14 3v10.8a3.3 3.3 0 1 1-3.3-3.3c.28 0 .55.03.8.1V7.9a6 6 0 1 0 5.1 5.93V9.6c1 .66 2.2 1.05 3.4 1.05V7.9c-1.9 0-3.5-1.53-3.5-3.4V3H14Z" fill="currentColor"/>
  </svg>
)}
{(key === 'twitter' || key === 'x') && (
  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M4 4L20 20M20 4L4 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
  </svg>
)}
{key === 'threads' && (
  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/>
    <path d="M9 9.5c0-1.4 1.2-2.3 2.7-2.3 2 0 3.3 1.5 3.3 4v1.6c0 2.5-1.3 4-3.3 4-1.5 0-2.7-.8-2.7-2.1 0-1.4 1.3-2.1 3-2.1h1.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
  </svg>
)}
{key === 'twitch' && (
  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M4 3.5h16v10l-4 4h-3.5L10 20H7v-2.5H3.5V6L4 3.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    <path d="M10.5 8v4.2M14.5 8v4.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
  </svg>
)}
{!['youtube','instagram','tiktok','twitter','x','threads','twitch'].includes(key) && (
  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/>
    <path d="M12 8v5M12 15.5v.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
  </svg>
)}

<style>
  svg { width: 22px; height: 22px; display: block; }
</style>
