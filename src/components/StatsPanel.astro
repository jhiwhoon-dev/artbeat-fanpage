---
// videos / shorts 탭 상단 통계 그래프 묶음. 카테고리별로 칸을 나눠 표시함.
//   오늘: 오늘 누적 조회수 / 좋아요 (오늘 이전 마지막 스냅샷 대비 증가분) + 최근 14일 일별 증가분
//   업로드: 일별 업로드 추이(최근 30일), 연간 업로드 수
//   연간: 총 조회수 / 총 좋아요 — 토글로 "업로드 연도 기준" ↔ "연간 증가분 기준" 전환
// 그래프는 빌드 때 SVG 문자열로 만들어져서(src/lib/chartSvg.mjs) 자바스크립트 없이도 보이고,
// 아래 <script>는 토글과 호버 툴팁만 담당함.
import { areaChart, barChart, fmtNum } from '../lib/chartSvg.mjs';

const { stats, label = 'Video', uid = 'v' } = Astro.props;

const C_VIEWS = '#4cc2ff';
const C_LIKES = '#ff6fa5';
const C_UP = '#ff9a3c';

const t = stats.today;
const trend = stats.trend;
const yr = stats.yearly;

const trendViews = areaChart({ id: `${uid}-tv`, labels: trend.labels, values: trend.views, color: C_VIEWS, unit: '회', maxLabels: 5 });
const trendLikes = areaChart({ id: `${uid}-tl`, labels: trend.labels, values: trend.likes, color: C_LIKES, unit: '개', maxLabels: 5 });
const daily = barChart({ id: `${uid}-dl`, labels: stats.daily.labels, values: stats.daily.values, color: C_UP, unit: '개', maxLabels: 8 });
const yearlyUploads = barChart({ id: `${uid}-yu`, labels: yr.labels, values: yr.uploads, color: C_UP, unit: '개', maxLabels: 12, showValues: yr.labels.length <= 12 });
const yViewsUpload = areaChart({ id: `${uid}-yvu`, labels: yr.labels, values: yr.byUpload.views, color: C_VIEWS, unit: '회', maxLabels: 8 });
const yViewsGain = areaChart({ id: `${uid}-yvg`, labels: yr.labels, values: yr.byGain.views, color: C_VIEWS, unit: '회', maxLabels: 8 });
const yLikesUpload = areaChart({ id: `${uid}-ylu`, labels: yr.labels, values: yr.byUpload.likes, color: C_LIKES, unit: '개', maxLabels: 8 });
const yLikesGain = areaChart({ id: `${uid}-ylg`, labels: yr.labels, values: yr.byGain.likes, color: C_LIKES, unit: '개', maxLabels: 8 });

const sum = (a) => a.reduce((x, y) => x + (y ?? 0), 0);
const totalUploads = sum(yr.uploads);
const totalViews = sum(yr.byUpload.views);
const totalLikes = sum(yr.byUpload.likes);
const sinceLabel = stats.firstSnapshot ? stats.firstSnapshot.replace(/-/g, '.') : null;
---

<section class="stats" data-stats aria-label={`${label} 통계`}>
  <div class="stats-group">
    <h2 class="stats-h">오늘 <span class="stats-sub">{t.date.replace(/-/g, '.')} 0시(KST) 이후 증가분</span></h2>
    <div class="stats-grid two">
      <article class="stat-card">
        <header><span class="dot" style={`background:${C_VIEWS}`}></span>오늘 누적 조회수</header>
        <div class="kpi"><b style={`color:${C_VIEWS}`}>+{fmtNum(t.views)}</b><span>회</span></div>
        <p class="kpi-note">{t.yesterdayViews != null ? `어제 하루 +${fmtNum(t.yesterdayViews)}회` : '어제 기록 없음'}</p>
        <div class="chart-wrap" set:html={trendViews} />
        <p class="chart-cap">최근 14일 일별 증가분</p>
      </article>
      <article class="stat-card">
        <header><span class="dot" style={`background:${C_LIKES}`}></span>오늘 누적 좋아요</header>
        <div class="kpi"><b style={`color:${C_LIKES}`}>+{fmtNum(t.likes)}</b><span>개</span></div>
        <p class="kpi-note">{t.yesterdayLikes != null ? `어제 하루 +${fmtNum(t.yesterdayLikes)}개` : '어제 기록 없음'}</p>
        <div class="chart-wrap" set:html={trendLikes} />
        <p class="chart-cap">최근 14일 일별 증가분</p>
      </article>
    </div>
  </div>

  <div class="stats-group">
    <h2 class="stats-h">업로드</h2>
    <div class="stats-grid two">
      <article class="stat-card">
        <header><span class="dot" style={`background:${C_UP}`}></span>일별 {label} 업로드 추이</header>
        <div class="chart-wrap" set:html={daily} />
        <p class="chart-cap">최근 30일</p>
      </article>
      <article class="stat-card">
        <header><span class="dot" style={`background:${C_UP}`}></span>연간 {label} 업로드 수 변화</header>
        <div class="chart-wrap" set:html={yearlyUploads} />
        <p class="chart-cap">전체 {fmtNum(totalUploads)}개 · {yr.labels[yr.labels.length - 1]}년은 집계 진행 중</p>
      </article>
    </div>
  </div>

  <div class="stats-group" data-mode-group>
    <div class="stats-head-row">
      <h2 class="stats-h">연간 조회수 · 좋아요</h2>
      <div class="seg" role="tablist" aria-label="집계 기준">
        <button type="button" class="seg-btn active" data-mode="upload" role="tab" aria-selected="true">업로드 연도 기준</button>
        <button type="button" class="seg-btn" data-mode="gain" role="tab" aria-selected="false">연간 증가분 기준</button>
      </div>
    </div>
    <p class="mode-note" data-note="upload">그 해에 올라온 {label}들의 현재 누적 합계입니다.</p>
    <p class="mode-note" data-note="gain" hidden>그 해에 실제로 늘어난 수치입니다. 기록은 {sinceLabel ?? '아직 없음'}부터 쌓여 그 이전 연도는 '집계 전'으로 비워 둡니다.</p>
    <div class="stats-grid two">
      <article class="stat-card">
        <header><span class="dot" style={`background:${C_VIEWS}`}></span>연간 총 조회수 변화</header>
        <div class="chart-wrap" data-pane="upload" set:html={yViewsUpload} />
        <div class="chart-wrap" data-pane="gain" hidden set:html={yViewsGain} />
        <p class="chart-cap" data-pane="upload">전체 합계 {fmtNum(totalViews)}회</p>
        <p class="chart-cap" data-pane="gain" hidden>연간 증가분 합계</p>
      </article>
      <article class="stat-card">
        <header><span class="dot" style={`background:${C_LIKES}`}></span>연간 총 좋아요 수 변화</header>
        <div class="chart-wrap" data-pane="upload" set:html={yLikesUpload} />
        <div class="chart-wrap" data-pane="gain" hidden set:html={yLikesGain} />
        <p class="chart-cap" data-pane="upload">전체 합계 {fmtNum(totalLikes)}개</p>
        <p class="chart-cap" data-pane="gain" hidden>연간 증가분 합계</p>
      </article>
    </div>
  </div>

  <div class="stat-tip" hidden></div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-stats]').forEach((root) => {
    // 업로드 연도 기준 ↔ 연간 증가분 기준 토글
    const group = root.querySelector<HTMLElement>('[data-mode-group]');
    group?.querySelectorAll<HTMLButtonElement>('.seg-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.dataset.mode;
        group.querySelectorAll<HTMLButtonElement>('.seg-btn').forEach((b) => {
          const on = b === btn;
          b.classList.toggle('active', on);
          b.setAttribute('aria-selected', String(on));
        });
        group.querySelectorAll<HTMLElement>('[data-pane]').forEach((el) => (el.hidden = el.dataset.pane !== mode));
        group.querySelectorAll<HTMLElement>('[data-note]').forEach((el) => (el.hidden = el.dataset.note !== mode));
      });
    });

    // 호버 툴팁: 그래프 안의 .hit 영역이 가진 data-tip 텍스트를 보여줌
    const tip = root.querySelector<HTMLElement>('.stat-tip');
    if (!tip) return;
    root.addEventListener('pointermove', (e) => {
      const hit = (e.target as Element).closest?.('.hit');
      if (!hit) {
        tip.hidden = true;
        return;
      }
      tip.textContent = hit.getAttribute('data-tip') ?? '';
      tip.hidden = false;
      const r = root.getBoundingClientRect();
      const x = Math.min(e.clientX - r.left + 12, r.width - tip.offsetWidth - 4);
      tip.style.left = `${Math.max(4, x)}px`;
      tip.style.top = `${e.clientY - r.top - 34}px`;
    });
    root.addEventListener('pointerleave', () => (tip.hidden = true));
  });
</script>

<style is:global>
  .stats {
    --stat-card: #131318;
    --stat-grid: #26262c;
    position: relative;
    margin: 24px 0 40px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .stats-h { font-size: 15px; font-weight: 700; margin: 0 0 12px; color: var(--ink); }
  .stats-sub { font-size: 12px; font-weight: 400; color: var(--muted); margin-left: 8px; }
  .stats-head-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 4px; }
  .stats-head-row .stats-h { margin: 0; }
  .stats-grid { display: grid; gap: 14px; }
  .stats-grid.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .stat-card {
    background: var(--stat-card);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 18px 18px 14px;
    min-width: 0;
  }
  .stat-card header { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--muted); margin-bottom: 10px; }
  .stat-card .dot { width: 8px; height: 8px; border-radius: 50%; flex: none; }
  .kpi { display: flex; align-items: baseline; gap: 6px; }
  .kpi b { font-size: 32px; line-height: 1.1; font-variant-numeric: tabular-nums; font-family: 'Archivo', sans-serif; }
  .kpi span { font-size: 13px; color: var(--muted); }
  .kpi-note { font-size: 12px; color: var(--muted); margin: 4px 0 10px; }
  .chart-wrap { margin-top: 4px; }
  .chart-wrap[hidden], .chart-cap[hidden], .mode-note[hidden], .stat-tip[hidden] { display: none; }
  .chart-cap { font-size: 11px; color: var(--muted); margin: 6px 0 0; opacity: .85; }
  .mode-note { font-size: 12px; color: var(--muted); margin: 0 0 12px; }

  .seg { display: inline-flex; border: 1px solid var(--line); border-radius: 999px; padding: 3px; gap: 2px; background: var(--stat-card); }
  .seg-btn {
    font: inherit; font-size: 12px; padding: 5px 12px; border-radius: 999px; border: 0;
    background: transparent; color: var(--muted); cursor: pointer;
  }
  .seg-btn:hover { color: var(--ink); }
  .seg-btn.active { background: var(--ink); color: var(--bg); font-weight: 600; }
  .seg-btn:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

  /* SVG 내부 */
  .stats svg.chart { width: 100%; height: auto; display: block; overflow: visible; }
  .stats .grid { stroke: var(--stat-grid); stroke-width: 1; stroke-dasharray: 3 5; }
  .stats .grid.solid { stroke-dasharray: none; stroke: var(--line); }
  .stats .line { fill: none; stroke-width: 2.4; stroke-linejoin: round; stroke-linecap: round; }
  .stats .xl, .stats .axis-max { font-size: 11px; fill: var(--muted); font-family: 'Archivo', sans-serif; }
  .stats .axis-max { text-anchor: start; }
  .stats .bv { font-size: 11px; fill: var(--ink); font-family: 'Archivo', sans-serif; font-variant-numeric: tabular-nums; }
  .stats .empty { font-size: 13px; fill: var(--muted); }
  .stats .hit { fill: transparent; cursor: crosshair; }
  .stats .guide { stroke: var(--muted); stroke-width: 1; opacity: 0; pointer-events: none; }
  .stats .hover-dot { opacity: 0; pointer-events: none; }
  .stats .hit-g:hover .guide, .stats .hit-g:hover .hover-dot { opacity: 1; }
  .stats .bars .bar { transition: opacity .15s; }

  .stat-tip {
    position: absolute; z-index: 5; pointer-events: none; white-space: nowrap;
    background: #1c1c22; color: var(--ink); border: 1px solid var(--line); border-radius: 8px;
    padding: 5px 9px; font-size: 12px; font-variant-numeric: tabular-nums; box-shadow: 0 6px 18px rgba(0,0,0,.45);
  }

  @media (max-width: 760px) {
    .stats-grid.two { grid-template-columns: 1fr; }
    .kpi b { font-size: 28px; }
  }
</style>
