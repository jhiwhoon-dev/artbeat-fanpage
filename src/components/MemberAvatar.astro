---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  member: { name: string; photo_filename: string | null };
  size?: number;
}

const { member, size = 96 } = Astro.props;

// 빌드 타임에 실제로 사진 파일이 있는지 확인 (없으면 이니셜로 대체)
const hasPhoto =
  !!member.photo_filename &&
  fs.existsSync(path.join(process.cwd(), 'public', 'photos', member.photo_filename));

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const initial = member.name.trim().charAt(0);
---
{hasPhoto ? (
  <img
    class="avatar-photo"
    src={`${base}/photos/${member.photo_filename}`}
    alt={member.name}
    width={size}
    height={size}
    loading="lazy"
  />
) : (
  <div class="avatar-fallback" style={`width:${size}px;height:${size}px;font-size:${size * 0.4}px;`}>
    {initial}
  </div>
)}

<style>
  .avatar-photo {
    border-radius: 50%;
    object-fit: cover;
    display: block;
    flex-shrink: 0;
  }
  .avatar-fallback {
    border-radius: 50%;
    background: #232326;
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Archivo Black', sans-serif;
    flex-shrink: 0;
  }
</style>
