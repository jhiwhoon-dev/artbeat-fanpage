---
import Layout from '../../layouts/Layout.astro';
import MemberAvatar from '../../components/MemberAvatar.astro';
import PlatformIcon from '../../components/PlatformIcon.astro';
import members from '../../data/members.json';
import allVideos from '../../data/videos.json';
import contentSeriesDict from '../../data/content_series.json';

// 빌드 타임에 members.json을 순회하며 멤버 수만큼 정적 페이지를 미리 생성합니다.
// 멤버가 3명이든 66명이든 이 코드는 그대로 두면 됩니다.
export function getStaticPaths() {
  return members.map((member) => ({
    params: { id: member.id },
    props: { member },
  }));
}

const { member } = Astro.props;
const snsLabels = {
  instagram: 'Instagram',
  youtube: 'YouTube',
  tiktok: 'TikTok',
  threads: 'Threads',
  naverclip: '네이버 클립',
  twitch: 'Twitch',
  soop: 'SOOP',
};

// 이 멤버가 tagged_members에 포함된 영상만 모아서 최신순으로 정렬
// 이 멤버가 tagged_members(메인 커버) 또는 special_dancers(백업 댄서) 중 하나라도 포함된 영상 = "출연한 영상"
const taggedVideos = allVideos
  .filter((v) => (v.tagged_members ?? []).includes(member.id) || (v.special_dancers ?? []).includes(member.id))
  .sort((a, b) => b.published_date.localeCompare(a.published_date));

// content_type이 없는 예전 데이터도 인식하도록 하는 헬퍼 (videos.astro와 동일한 규칙)
function getType(v) {
  if (v.content_type) return v.content_type;
  return v.is_short ? 'short' : 'video';
}

// 활동 통계는 'video'만 집계 (shorts, live 제외). 아래 "출연 영상" 목록/필터는 taggedVideos를 그대로 써서
// shorts, live도 계속 보이게 함 — 통계 집계에서만 제외하는 것.
const statsVideos = taggedVideos.filter((v) => getType(v) === 'video');

// 동기/전체 평균 계산은 "이 멤버가 태그된 영상"이 아니라 "사이트 전체 영상"을 대상으로 해야 함
const allStatsVideos = allVideos.filter((v) => getType(v) === 'video');

// 출연 영상 필터 엔진(videos.astro와 동일)에 넘길 데이터
const seriesStatusMap = Object.fromEntries(contentSeriesDict.map((s) => [s.name, s.status]));
const memberMap = Object.fromEntries(members.map((m) => [m.id, m.nickname || m.name]));
const taggedVideosData = taggedVideos.map((v) => ({
  id: v.youtube_id,
  title: v.title,
  groups: v.covered_group ?? [],
  series: v.content_series ?? [],
  members: (v.tagged_members ?? []).filter((id) => id !== member.id), // 본인 태그는 빼고 "같이 출연한 멤버(메인)"만
  specialDancers: (v.special_dancers ?? []).filter((id) => id !== member.id), // 본인 태그는 빼고 "같이 백업 댄서였던 멤버"만
  isSelfSpecial: (v.special_dancers ?? []).includes(member.id), // 본인이 이 영상에서 백업 댄서였는지
  sponsors: v.sponsors ?? [],
  contentType: getType(v), // 'video' | 'short' | 'live' — 타입별 숨기기 필터용
  songKey: v.song_group || v.youtube_id, // 같은 곡 여러 영상을 1회로 묶기 위한 키
  myRole: (v.role_mapping ?? []).find((rm) => rm.member_id === member.id)?.covered_member ?? null, // 이 영상에서 본인이 맡은 원곡 인물
  date: v.published_date,
  views: v.view_count ?? 0,
}));

function safeJson(obj) {
  return JSON.stringify(obj).replace(/</g, '\\u003c');
}

// 함께 출연한 멤버별 영상 개수 집계 (본인 제외), 많이 함께한 순 정렬
const collabCounts = {};
for (const v of taggedVideos) {
  const everyone = [...new Set([...(v.tagged_members ?? []), ...(v.special_dancers ?? [])])];
  for (const coId of everyone) {
    if (coId === member.id) continue;
    collabCounts[coId] = (collabCounts[coId] ?? 0) + 1;
  }
}
const collabList = Object.entries(collabCounts)
  .map(([id, count]) => {
    const m = members.find((mm) => mm.id === id);
    return m ? { id, name: m.nickname || m.name, photo_filename: m.photo_filename, count } : null;
  })
  .filter(Boolean)
  .sort((a, b) => b.count - a.count);

// ---------- 활동 통계 ----------

// 출연 추이 차트용: 태그된 영상들의 published_date 목록만 클라이언트로 넘김 ('video' 타입만)
const taggedDates = statsVideos.map((v) => v.published_date);

// ---------- 비교선용: "동기" 그룹 평균, "전체" 멤버 평균, 채널 전체 업로드 수 ----------

// 이 멤버의 최초 합류일 (재합류 이력이 있으면 첫 번째 합류일 기준)
function firstJoinDate(m) {
  if (m.membership_periods && m.membership_periods.length > 0) return m.membership_periods[0].joined;
  return m.joined_date ?? null;
}

const myJoinDate = firstJoinDate(member);
const myJoinYear = myJoinDate ? myJoinDate.slice(0, 4) : null;
// 동기 판단 기준 = "합류 연도"만 봄 (정확한 날짜나 어느 유닛/크루로 들어왔는지는 안 따짐).
// 예: 2025년 상반기에 AB PROJECT로, 하반기에 또 AB PROJECT로 들어왔어도 전부 "2025년 합류"로 묶임.
// A2Be로 들어왔다가 나중에 AB PROJECT로 합쳐진 경우도, 그 사람의 "합류 연도"만 같으면 동기로 봄.
const cohortMembers = myJoinYear
  ? members.filter((m) => m.status !== 'audition' && firstJoinDate(m) && firstJoinDate(m).slice(0, 4) === myJoinYear)
  : [];
const hasCohort = cohortMembers.length > 1; // 나 혼자면 비교 의미 없음

// 오디션 제외 전체 멤버(활동 이력이 있을 수 있는 대상)
const allRealMembers = members.filter((m) => m.status !== 'audition');

// videos 하나당 "출연한 사람 한 명 = 이벤트 하나"로 풀어서, 특정 집단(idSet)에 속한 사람의 출연일만 모음
function appearanceDatesFor(videos, idSet) {
  const dates = [];
  for (const v of videos) {
    const everyone = [...new Set([...(v.tagged_members ?? []), ...(v.special_dancers ?? [])])];
    for (const id of everyone) {
      if (idSet.has(id)) dates.push(v.published_date);
    }
  }
  return dates;
}

const allRealMemberIds = new Set(allRealMembers.map((m) => m.id));
const overallAppearanceDates = appearanceDatesFor(allStatsVideos, allRealMemberIds);
const overallDivisor = allRealMemberIds.size || 1;

const cohortIds = new Set(cohortMembers.map((m) => m.id));
const cohortAppearanceDates = hasCohort ? appearanceDatesFor(allStatsVideos, cohortIds) : [];
const cohortDivisor = cohortIds.size || 1;
// ⚠️ 이 문구는 "AB PROJECT"라고 못박지 않고 일반적으로 표현했어요 — 매년 모집 프로그램 이름이
// 항상 "AB PROJECT"였는지 제가 확신할 수 없어서예요. 항상 "AB PROJECT"라고 고정하고 싶으시면 말씀해주세요.
const cohortLabel = hasCohort ? `${myJoinYear}년 ARTBEAT 합류 멤버 평균 (${cohortMembers.length}명)` : '';

// 채널 전체 업로드 추이 (내 영상이 전체에서 차지하는 비중을 보기 위함) — 'video' 타입만, shorts/live 제외
const channelUploadDates = allStatsVideos.map((v) => v.published_date);

// 합류/탈퇴 시점 — 차트에 세로선으로 표시하기 위한 데이터.
// membership_periods가 없으면 joined_date/left_date 단일 값을 씀 (재합류 이력이 없는 멤버용)
const membershipMilestones = (
  member.membership_periods && member.membership_periods.length > 0
    ? member.membership_periods
    : member.joined_date
      ? [{ joined: member.joined_date, left: member.left_date ?? null }]
      : []
).flatMap((p) => {
  const arr = [];
  if (p.joined) arr.push({ date: p.joined, label: '합류' });
  if (p.left) arr.push({ date: p.left, label: '탈퇴' });
  return arr;
});


// URL에서 "@핸들" 형태로 보여줄 텍스트를 뽑아냄 (실패하면 그냥 URL 그대로)
// sns 배열의 각 항목은 문자열(URL만) 또는 {url, handle}(직접 표시 텍스트 지정) 둘 다 지원.
// 문자열이면 URL에서 자동으로 "@핸들"을 뽑아냄 (한글은 디코딩해서 깨지지 않게 함).
function resolveSnsEntry(entry) {
  const url = typeof entry === 'string' ? entry : entry.url;
  if (typeof entry === 'object' && entry.handle) {
    return { url, handle: entry.handle };
  }
  return { url, handle: extractHandle(url) };
}

function extractHandle(url) {
  try {
    const u = new URL(url);
    const path = decodeURIComponent(u.pathname).replace(/^\/+|\/+$/g, '');
    if (!path) return u.hostname;
    return `@${path.split('/')[0].replace(/^@/, '')}`;
  } catch {
    return url;
  }
}

// 여러 활동 기간(membership_periods)을 합산해 총 활동일수를 계산
// (공백 기간 - 탈퇴~재합류 사이 - 은 제외하고 계산)
function calcActiveDays(periods) {
  if (!periods || periods.length === 0) return 0;
  const now = new Date();
  let totalMs = 0;
  for (const p of periods) {
    const start = new Date(p.joined);
    const end = p.left ? new Date(p.left) : now;
    if (!isNaN(start) && !isNaN(end)) totalMs += Math.max(0, end - start);
  }
  return Math.floor(totalMs / 86400000);
}

const periods = member.membership_periods ?? [];
const activeDays = calcActiveDays(periods);
const anniversaryYears = Math.floor(activeDays / 365);
const isCurrentlyActive = periods.length > 0 && periods[periods.length - 1].left === null;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title={member.name}>
  <div class="wrap">
    <a class="back" href={`${base}/members`}>← 멤버 목록</a>
    <div class="avatar-wrap"><MemberAvatar member={member} size={128} /></div>
    <p class="eyebrow">{member.role} · {member.status === 'active' ? '활동 중' : member.status}</p>
    <h1>{member.name}</h1>

    {member.unit.length > 0 && (
      <p class="units">{member.unit.join(' · ')}</p>
    )}

    {member.bio && (
      <p class="bio">{member.bio}</p>
    )}

    <dl class="meta">
      <div class="meta-row"><dt>가입일</dt><dd>{member.joined_date ?? '-'}</dd></div>
      {periods.length > 1 && (
        <div class="meta-row"><dt>재합류일</dt><dd>{periods[periods.length - 1].joined}</dd></div>
      )}
      {member.status === 'withdrawn' && member.left_date && (
        <div class="meta-row"><dt>탈퇴일</dt><dd>{member.left_date}</dd></div>
      )}
    </dl>

    {activeDays > 0 && (
      <p class="tenure">
        {isCurrentlyActive
          ? <>소속일로부터 <strong>+{activeDays}일</strong>, {anniversaryYears > 0 ? `${anniversaryYears}주년` : '1주년 미만'}</>
          : <>총 활동 <strong>{activeDays}일</strong> ({anniversaryYears > 0 ? `${anniversaryYears}주년 분` : '1년 미만'})</>
        }
      </p>
    )}

    {Object.keys(member.sns).length > 0 && (
      <div class="social-grid">
        {Object.entries(member.sns).flatMap(([platform, entries]) =>
          entries.map((entry) => {
            const { url, handle } = resolveSnsEntry(entry);
            return (
              <a class="social-card" href={url} target="_blank" rel="noopener noreferrer">
                <div class="social-icon"><PlatformIcon platform={platform} /></div>
                <div class="social-text">
                  <strong>{snsLabels[platform] ?? platform.toUpperCase()}</strong>
                  <span title={handle}>{handle}</span>
                </div>
              </a>
            );
          })
        )}
      </div>
    )}

    {collabList.length > 0 && (
      <div class="collab-section">
        <h2>함께한 멤버 ({collabList.length})</h2>
        <div class="collab-grid">
          {collabList.map((c) => (
            <a class="collab-card" href={`${base}/members/${c.id}`}>
              <MemberAvatar member={c} size={48} />
              <span class="collab-name">{c.name}</span>
              <span class="collab-count">{c.count}영상</span>
            </a>
          ))}
        </div>
      </div>
    )}

    {taggedVideos.length > 0 && (
      <div class="stats-section">
        <h2>활동 통계</h2>

        <div class="stat-block">
          <div class="stat-block-head">
            <h3>출연 추이</h3>
            <div class="stat-toggle" id="trend-toggle">
              <button class="stat-toggle-btn active" data-view="year">연도별</button>
              <button class="stat-toggle-btn" data-view="month">월별</button>
            </div>
          </div>
          <div class="chart-legend" id="trend-chart-legend"></div>
          <p class="chart-hover-info" id="trend-hover-info">그래프의 점에 마우스를 올리면 여기에 정확한 값이 표시돼요.</p>
          <div class="chart-scroll" id="trend-chart-wrap"></div>
        </div>
      </div>
    )}

    {taggedVideos.length > 0 && (
      <div class="tagged-videos">
        <h2>출연 영상 ({taggedVideos.length})</h2>

        <div class="controls-top">
          <div class="mode-tabs" id="mode-tabs">
            <button class="mode-btn active" data-mode="group">그룹별</button>
            <button class="mode-btn" data-mode="series">콘텐츠별</button>
            {collabList.length > 0 && (
              <button class="mode-btn" data-mode="member">멤버별</button>
            )}
          </div>
          <div class="controls-right">
            <input type="text" class="title-search" id="title-search" placeholder="영상 제목 검색..." />
            <select id="sort-select" class="sort-select">
              <option value="newest">최신순</option>
              <option value="oldest">오래된순</option>
              <option value="views">조회수순</option>
            </select>
          </div>
        </div>

        <div class="type-toggle" id="type-toggle">
          <button class="type-toggle-btn active" data-type="video">영상</button>
          <button class="type-toggle-btn active" data-type="short">쇼츠</button>
          <button class="type-toggle-btn active" data-type="live">라이브</button>
        </div>

        <div class="filter-panel" id="panel-group">
          <div id="group-levels"></div>
        </div>
        <div class="filter-panel" id="panel-series" style="display:none">
          <div class="series-status" id="series-status" style="display:none"></div>
          <div id="series-levels"></div>
        </div>
        <div class="filter-panel" id="panel-member" style="display:none">
          <div class="filters" id="filters-member">
            <button class="filter-btn active" data-value="__all__">전체</button>
            {collabList.map((c) => (
              <button class="filter-btn" data-value={c.id}>{c.name} ({c.count}영상)</button>
            ))}
          </div>
          {collabList.map((c) => (
            <a class="collab-profile-card" data-collab-id={c.id} href={`${base}/members/${c.id}`} style="display:none">
              <MemberAvatar member={c} size={56} />
              <div>
                <strong>{c.name}</strong>
                <span>프로필 보러가기 →</span>
              </div>
            </a>
          ))}
        </div>

        <!-- 그룹별 필터에서 특정 그룹(또는 그 하위)을, 멤버별 필터에서 특정 멤버를 선택하면
             여기에 그 선택에 대한 시계열 그래프가 자동으로 뜸 (선택 안 하면 안 보임) -->
        <div class="selection-chart-block" id="selection-chart-block" style="display:none">
          <div class="stat-block-head">
            <h3 id="selection-chart-title">선택 통계</h3>
            <div class="stat-toggle" id="selection-period-toggle">
              <button class="stat-toggle-btn active" data-view="year">연도별</button>
              <button class="stat-toggle-btn" data-view="month">월별</button>
            </div>
          </div>
          <p class="chart-hover-info" id="selection-hover-info">그래프의 점에 마우스를 올리면 여기에 정확한 값이 표시돼요.</p>
          <div class="chart-scroll" id="selection-chart-wrap"></div>

          <!-- 그룹별 선택일 때만 나옴: 그 그룹에서 실제로 누구를 몇 번/몇 %로 맡았는지 + 전체 출연 중 이 그룹 비중 -->
          <div class="role-breakdown" id="role-breakdown" style="display:none">
            <p class="role-share-line" id="role-share-line"></p>
            <div class="role-bars" id="role-bars"></div>
          </div>
        </div>

        <p class="count-label" id="count-label"></p>
        <div class="grid" id="grid"></div>
        <button class="load-more" id="load-more" hidden>더 보기</button>
        <p class="empty" id="empty" hidden>조건에 맞는 영상이 없어요.</p>
      </div>
    )}
  </div>

  <script type="application/json" id="videos-data" set:html={safeJson(taggedVideosData)} />
  <script type="application/json" id="member-map-data" set:html={safeJson(memberMap)} />
  <script type="application/json" id="base-data" set:html={safeJson(base)} />
  <script type="application/json" id="series-status-data" set:html={safeJson(seriesStatusMap)} />
  <script type="application/json" id="tagged-dates-data" set:html={safeJson(taggedDates)} />
  <script type="application/json" id="cohort-dates-data" set:html={safeJson(cohortAppearanceDates)} />
  <script type="application/json" id="overall-dates-data" set:html={safeJson(overallAppearanceDates)} />
  <script type="application/json" id="channel-upload-dates-data" set:html={safeJson(channelUploadDates)} />
  <script type="application/json" id="cohort-meta-data" set:html={safeJson({ hasCohort, cohortDivisor, overallDivisor, cohortLabel })} />
  <script type="application/json" id="membership-milestones-data" set:html={safeJson(membershipMilestones)} />
</Layout>
<script>
  interface VideoItem {
    id: string;
    title: string;
    groups: string[];
    series: string[];
    members: string[];
    specialDancers: string[];
    isSelfSpecial: boolean;
    sponsors: string[];
    contentType: 'video' | 'short' | 'live';
    songKey: string;
    myRole: string | null;
    date: string;
    views: number;
  }

  const DATA: VideoItem[] = JSON.parse(document.getElementById('videos-data')!.textContent!);
  const MEMBER_MAP: Record<string, string> = JSON.parse(document.getElementById('member-map-data')!.textContent!);
  const BASE: string = JSON.parse(document.getElementById('base-data')!.textContent!);
  const SERIES_STATUS: Record<string, string> = JSON.parse(document.getElementById('series-status-data')!.textContent!);

  const PAGE_SIZE = 30;
  let currentPage = 1;
  let activeMode: 'group' | 'series' | 'member' = 'group';
  let activeGroupPath: string[] = [];
  let activeSeriesPath: string[] = [];
  let activeMemberId: string | null = null;
  let sortMode = 'newest';
  let titleQuery = '';

  // ---------- 필터 상태를 URL에 기록/복원 (뒤로가기 눌렀을 때 이전 필터 상태 유지) ----------
  function currentUrlWithState(): URL {
    const url = new URL(window.location.href);
    const p = url.searchParams;
    if (activeMode !== 'group') p.set('mode', activeMode); else p.delete('mode');
    if (activeGroupPath.length) p.set('gpath', activeGroupPath.join('|')); else p.delete('gpath');
    if (activeSeriesPath.length) p.set('spath', activeSeriesPath.join('|')); else p.delete('spath');
    if (activeMemberId) p.set('mid', activeMemberId); else p.delete('mid');
    if (sortMode !== 'newest') p.set('sort', sortMode); else p.delete('sort');
    if (titleQuery) p.set('q', titleQuery); else p.delete('q');
    return url;
  }
  // 버튼 클릭처럼 "명확한 한 번의 선택"은 뒤로가기 기록에 남김
  function pushUrlState() { history.pushState(null, '', currentUrlWithState()); }
  // 검색창 타이핑처럼 계속 바뀌는 값은 기록을 안 쌓고 주소만 조용히 갱신
  function replaceUrlState() { history.replaceState(null, '', currentUrlWithState()); }

  function readUrlState() {
    const params = new URLSearchParams(window.location.search);
    const rawMode = params.get('mode');
    const mode = (rawMode === 'series' || rawMode === 'member' ? rawMode : 'group') as 'group' | 'series' | 'member';
    return {
      mode,
      gpath: params.get('gpath') ? params.get('gpath')!.split('|') : [],
      spath: params.get('spath') ? params.get('spath')!.split('|') : [],
      mid: params.get('mid') || null,
      sort: params.get('sort') || 'newest',
      q: params.get('q') || '',
    };
  }

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] ?? c));
  }

  // "::"로 몇 단계든 이어붙인 태그를 배열로 분해 (그룹/콘텐츠 공통 규칙).
  // "::" 없이 "이름 S23" 형식(예전 방식)도 2단계로 인식.
  // 예: "BOYS PLANET::SAY YES!" -> ["BOYS PLANET", "SAY YES!"]
  //     "NCT::NCT 127" -> ["NCT", "NCT 127"]
  //     "방구석 여기서요? S23" -> ["방구석 여기서요?", "S23"]
  function splitTagLevels(tag: string): string[] {
    if (tag.includes('::')) return tag.split('::').map((s) => s.trim()).filter(Boolean);
    const m = tag.match(/^(.*?)\s*S(\d+)$/i);
    return m ? [m[1].trim(), `S${m[2]}`] : [tag];
  }

  // 태그가 현재 선택 경로(path)로 시작하는지 확인 (경로가 비어있으면 항상 매칭 = "전체")
  function matchesPath(tag: string, path: string[]): boolean {
    if (path.length === 0) return true;
    const segs = splitTagLevels(tag);
    if (segs.length < path.length) return false;
    return path.every((p, i) => segs[i] === p);
  }

  type TreeNode = Map<string, TreeNode>;

  // 영상들의 태그(그룹 또는 콘텐츠) 목록으로부터 트리를 만듦 — 깊이 제한 없이 몇 단계든 처리
  function buildTree(tagLists: string[][]): TreeNode {
    const root: TreeNode = new Map();
    for (const tags of tagLists) {
      for (const tag of tags) {
        const segs = splitTagLevels(tag);
        let node = root;
        for (const seg of segs) {
          if (!node.has(seg)) node.set(seg, new Map());
          node = node.get(seg)!;
        }
      }
    }
    return root;
  }

  const groupTree = buildTree(DATA.map((v) => v.groups));
  const seriesTree = buildTree(DATA.map((v) => v.series));

  // 트리 + 현재 선택 경로를 받아서, 선택할 때마다 하위 단계 버튼 행이 자동으로 늘어나는 UI를 그려줌.
  // 그룹/콘텐츠 둘 다 이 함수 하나를 공유해서 씀.
  function renderLevels(container: HTMLElement, tree: TreeNode, path: string[], onChange: (newPath: string[]) => void) {
    let rowsHtml = '';
    let node = tree;

    for (let depth = 0; ; depth++) {
      const keys = [...node.keys()].sort();
      if (keys.length === 0) break;

      const activeKeyAtDepth = path[depth];
      const buttons =
        `<button class="filter-btn ${activeKeyAtDepth === undefined ? 'active' : ''}" data-depth="${depth}" data-value="__all__">전체</button>` +
        keys.map((k) => `<button class="filter-btn ${k === activeKeyAtDepth ? 'active' : ''}" data-depth="${depth}" data-value="${escapeHtml(k)}">${escapeHtml(k)}</button>`).join('');
      rowsHtml += `<div class="filters series-level" data-depth="${depth}">${buttons}</div>`;

      if (!activeKeyAtDepth) break;
      node = node.get(activeKeyAtDepth)!;
    }

    container.innerHTML = rowsHtml;
    container.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const depth = Number(btn.dataset.depth);
        const value = btn.dataset.value!;
        const newPath = value === '__all__' ? path.slice(0, depth) : [...path.slice(0, depth), value];
        onChange(newPath);
      });
    });
  }

  const grid = document.getElementById('grid')!;
  const emptyEl = document.getElementById('empty')!;
  const loadMoreBtn = document.getElementById('load-more')!;
  const countLabel = document.getElementById('count-label')!;
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
  const modeButtons = document.querySelectorAll<HTMLButtonElement>('.mode-btn');
  const panelGroup = document.getElementById('panel-group');
  const panelSeries = document.getElementById('panel-series');
  const panelMember = document.getElementById('panel-member');
  const groupLevelsEl = document.getElementById('group-levels')!;
  const seriesLevelsEl = document.getElementById('series-levels')!;
  const seriesStatusEl = document.getElementById('series-status');
  const memberFilterButtons = document.querySelectorAll<HTMLButtonElement>('#filters-member .filter-btn');
  const collabCards = document.querySelectorAll<HTMLAnchorElement>('.collab-profile-card');

  // 선택된 멤버의 미리보기 프로필 카드만 보여주고, 필터 버튼 활성 상태도 같이 맞춤
  function updateMemberPanel() {
    memberFilterButtons.forEach((b) => {
      const isAll = b.dataset.value === '__all__';
      b.classList.toggle('active', activeMemberId ? b.dataset.value === activeMemberId : isAll);
    });
    collabCards.forEach((card) => {
      card.style.display = card.dataset.collabId === activeMemberId ? '' : 'none';
    });
  }

  const STATUS_LABEL: Record<string, string> = { active: '진행중', paused: '일시중단', ended: '종료' };

  function updateSeriesStatus() {
    if (!seriesStatusEl) return;
    const topLevel = activeSeriesPath[0];
    const status = topLevel ? SERIES_STATUS[topLevel] : undefined;
    if (!status) {
      seriesStatusEl.style.display = 'none';
      seriesStatusEl.innerHTML = '';
      return;
    }
    const cls = status === 'active' ? 'status-active' : status === 'paused' ? 'status-paused' : 'status-ended';
    seriesStatusEl.innerHTML = `<span class="status-badge ${cls}">${STATUS_LABEL[status] ?? status}</span>`;
    seriesStatusEl.style.display = '';
  }

  function renderGroupLevels() {
    renderLevels(groupLevelsEl, groupTree, activeGroupPath, (newPath) => {
      activeGroupPath = newPath;
      currentPage = 1;
      renderGroupLevels();
      render();
      renderSelectionChart();
      pushUrlState();
    });
  }

  function renderSeriesLevels() {
    renderLevels(seriesLevelsEl, seriesTree, activeSeriesPath, (newPath) => {
      activeSeriesPath = newPath;
      currentPage = 1;
      updateSeriesStatus();
      renderSeriesLevels();
      render();
      pushUrlState();
    });
  }

  function displayTagPath(tag: string): string {
    return splitTagLevels(tag).join(' · ');
  }

  // ===== 조회수 등급별 빛 효과 — 아래 숫자들만 바꾸면 전부 조절됨 =====
  const GLOW_TIER_UNIT = 1_000_000;   // 등급 하나당 조회수 단위 (100만)
  const GLOW_MAX_TIER = 17;           // 최고 등급 (1700만 이상은 전부 이 등급으로 고정)
  const GLOW_MIN_BLUR = 9;            // 최저 등급(100만) 빛 번짐 반경 (px) — 검정 배경에서도 보이게 상향
  const GLOW_MAX_BLUR = 14;           // 최고 등급(1700만+) 빛 번짐 반경 (px)
  // 주의: 그리드 카드 간격이 20px이라, "번짐 반경 × 아래 PULSE_SCALE" 값이
  // 20px을 넘으면 옆 카드를 침범할 수 있음. 14 × 1.3 = 18.2로 여유를 둠.
  const GLOW_MIN_OPACITY = 0.45;      // 최저 등급 빛 불투명도 (0~1) — 검정 배경에서도 보이게 상향
  const GLOW_MAX_OPACITY = 0.8;       // 최고 등급 빛 불투명도 (0~1)
  const GLOW_SATURATION = 95;         // 채도 (%) — 높을수록 색이 선명함
  const GLOW_LIGHTNESS = 62;          // 명도 (%) — 검정 배경 대비를 위해 살짝 밝게 잡음
  const GLOW_START_HUE = 210;         // 최저 등급 색상(파랑, 0~360 색상환)
  const GLOW_END_HUE = 405;           // 최고 등급 색상(405 % 360 = 45, 골드)
  // 210 -> 405로 "증가하는 방향"으로 보라/핑크/빨강을 거쳐 골드로 가게 함.
  // (반대 방향으로 가면 초록/청록을 거치게 되는데, 그러면 등급이 높아질수록
  //  오히려 칙칙해 보여서 일부러 이 방향으로 잡음)
  const GLOW_PULSE_FROM_TIER = 12;    // 이 등급부터 은은하게 깜빡이는 애니메이션 켜짐 (0으로 하면 전부 깜빡임, 999로 하면 전부 고정)
  const GLOW_PULSE_DURATION = 2.4;    // 깜빡임 주기 (초). 클수록 느리고 차분함
  const GLOW_PULSE_SCALE = 1.3;       // 깜빡일 때 최대로 커지는 배율 (위 주의사항 참고)

  function computeGlow(views: number) {
    if (views < GLOW_TIER_UNIT) return null; // 100만 미만은 효과 없음
    const tier = Math.min(Math.floor(views / GLOW_TIER_UNIT), GLOW_MAX_TIER);
    const ratio = GLOW_MAX_TIER > 1 ? (tier - 1) / (GLOW_MAX_TIER - 1) : 1; // 0~1

    const hue = (GLOW_START_HUE + (GLOW_END_HUE - GLOW_START_HUE) * ratio) % 360;
    const blur = GLOW_MIN_BLUR + (GLOW_MAX_BLUR - GLOW_MIN_BLUR) * ratio;
    const opacity = GLOW_MIN_OPACITY + (GLOW_MAX_OPACITY - GLOW_MIN_OPACITY) * ratio;
    const pulse = tier >= GLOW_PULSE_FROM_TIER;

    return { tier, hue: hue.toFixed(0), blur: blur.toFixed(1), opacity: opacity.toFixed(2), pulse };
  }

  function cardHTML(v: VideoItem): string {
    const groupTags = v.groups.map((g) => `<span class="tag tag-group">${escapeHtml(displayTagPath(g))}</span>`).join('');
    const seriesTags = v.series.map((s) => `<span class="tag tag-series">${escapeHtml(displayTagPath(s))}</span>`).join('');
    const memberTags = v.members
      .filter((id) => MEMBER_MAP[id])
      .map((id) => `<a class="tag tag-member" href="${BASE}/members/${id}">#${escapeHtml(MEMBER_MAP[id])}</a>`)
      .join('');
    const specialTags = v.specialDancers
      .filter((id) => MEMBER_MAP[id])
      .map((id) => `<a class="tag tag-special" href="${BASE}/members/${id}">#${escapeHtml(MEMBER_MAP[id])} <em>백업</em></a>`)
      .join('');
    const adBadge = v.sponsors.length > 0
      ? `<span class="ad-badge">유료광고 · ${escapeHtml(v.sponsors.join(', '))}</span>`
      : '';
    const selfSpecialBadge = v.isSelfSpecial ? `<span class="self-special-badge">백업 댄서로 참여</span>` : '';
    const glow = computeGlow(v.views);
    const glowStyle = glow
      ? `--glow-hue:${glow.hue}; --glow-blur:${glow.blur}px; --glow-op:${glow.opacity}; --glow-sat:${GLOW_SATURATION}%; --glow-light:${GLOW_LIGHTNESS}%; --glow-duration:${GLOW_PULSE_DURATION}s;`
      : '';
    const glowClass = glow ? `has-glow${glow.pulse ? ' glow-pulse' : ''}` : '';
    const hotBadge = glow ? `<span class="hot-badge">🔥 인기 (${glow.tier} M)</span>` : '';
    return `
      <div class="card">
        <a class="thumb-link" href="https://www.youtube.com/watch?v=${v.id}" target="_blank" rel="noopener noreferrer">
          <div class="thumb-wrap ${glowClass}" style="${glowStyle}">
            ${adBadge}
            ${hotBadge}
            ${selfSpecialBadge}
            <img class="thumb" src="https://img.youtube.com/vi/${v.id}/hqdefault.jpg" alt="${escapeHtml(v.title)}" loading="lazy" />
            <span class="play">▶</span>
          </div>
          <p class="title">${escapeHtml(v.title)}</p>
        </a>
        <div class="tags">${groupTags}${seriesTags}${memberTags}${specialTags}</div>
      </div>`;
  }

  let visibleTypes = new Set<'video' | 'short' | 'live'>(['video', 'short', 'live']);

  function getFiltered(): VideoItem[] {
    return DATA.filter((v) => {
      if (!visibleTypes.has(v.contentType)) return false;
      if (titleQuery && !v.title.toLowerCase().includes(titleQuery)) return false;
      if (activeMode === 'group') {
        // 경로가 비어있으면(= "전체" 선택 상태) 태그가 하나도 없는 영상도 전부 통과시켜야 함.
        // v.groups.some(...)만 쓰면 배열이 비어있을 때 무조건 false가 나와서 "전체"인데도 걸러지는 버그가 생김.
        if (activeGroupPath.length === 0) return true;
        return v.groups.some((tag) => matchesPath(tag, activeGroupPath));
      }
      if (activeMode === 'member') {
        if (!activeMemberId) return true;
        return v.members.includes(activeMemberId);
      }
      if (activeSeriesPath.length === 0) return true;
      return v.series.some((tag) => matchesPath(tag, activeSeriesPath));
    });
  }

  function getSorted(list: VideoItem[]): VideoItem[] {
    const arr = [...list];
    if (sortMode === 'views') arr.sort((a, b) => b.views - a.views);
    else if (sortMode === 'oldest') arr.sort((a, b) => a.date.localeCompare(b.date));
    else arr.sort((a, b) => b.date.localeCompare(a.date));
    return arr;
  }

  function render() {
    const filtered = getSorted(getFiltered());
    const slice = filtered.slice(0, currentPage * PAGE_SIZE);

    grid.innerHTML = slice.map(cardHTML).join('');
    emptyEl.hidden = filtered.length > 0;
    loadMoreBtn.hidden = slice.length >= filtered.length;
    countLabel.textContent = filtered.length > 0 ? `총 ${filtered.length}개 중 ${slice.length}개 표시` : '';
  }

  loadMoreBtn.addEventListener('click', () => {
    currentPage++;
    render();
  });

  modeButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      modeButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeMode = (btn.dataset.mode as 'group' | 'series' | 'member') ?? 'group';
      currentPage = 1;

      if (panelGroup) panelGroup.style.display = activeMode === 'group' ? '' : 'none';
      if (panelSeries) panelSeries.style.display = activeMode === 'series' ? '' : 'none';
      if (panelMember) panelMember.style.display = activeMode === 'member' ? '' : 'none';

      render();
      renderSelectionChart();
      pushUrlState();
    });
  });

  memberFilterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeMemberId = btn.dataset.value === '__all__' ? null : (btn.dataset.value ?? null);
      currentPage = 1;
      updateMemberPanel();
      render();
      renderSelectionChart();
      pushUrlState();
    });
  });

  const titleSearchInput = document.getElementById('title-search') as HTMLInputElement | null;
  titleSearchInput?.addEventListener('input', () => {
    titleQuery = titleSearchInput.value.trim().toLowerCase();
    currentPage = 1;
    render();
    replaceUrlState(); // 타이핑마다 뒤로가기 기록이 쌓이지 않도록 replace로 처리
  });

  document.querySelectorAll<HTMLButtonElement>('#type-toggle .type-toggle-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const type = btn.dataset.type as 'video' | 'short' | 'live';
      if (visibleTypes.has(type)) {
        if (visibleTypes.size === 1) return; // 최소 하나는 켜져있어야 함 (다 끄면 아무것도 안 보이니까)
        visibleTypes.delete(type);
      } else {
        visibleTypes.add(type);
      }
      btn.classList.toggle('active', visibleTypes.has(type));
      currentPage = 1;
      render();
    });
  });

  sortSelect?.addEventListener('change', () => {
    sortMode = sortSelect.value;
    currentPage = 1;
    render();
    pushUrlState();
  });

  // 페이지가 "?mode=series&spath=..." 같은 주소로 열렸을 때(뒤로가기 포함) 그 상태로 시작
  function applyState(state: ReturnType<typeof readUrlState>) {
    activeMode = state.mode;
    activeGroupPath = state.gpath;
    activeSeriesPath = state.spath;
    activeMemberId = state.mid;
    sortMode = state.sort;
    titleQuery = state.q;
    currentPage = 1;

    modeButtons.forEach((b) => b.classList.toggle('active', b.dataset.mode === activeMode));
    if (panelGroup) panelGroup.style.display = activeMode === 'group' ? '' : 'none';
    if (panelSeries) panelSeries.style.display = activeMode === 'series' ? '' : 'none';
    if (panelMember) panelMember.style.display = activeMode === 'member' ? '' : 'none';
    if (sortSelect) sortSelect.value = sortMode;
    if (titleSearchInput) titleSearchInput.value = titleQuery;

    updateSeriesStatus();
    updateMemberPanel();
    renderGroupLevels();
    renderSeriesLevels();
    render();
    renderSelectionChart();
  }

  // 뒤로가기/앞으로가기로 주소가 바뀌면 그 시점 상태를 다시 반영
  window.addEventListener('popstate', () => {
    applyState(readUrlState());
  });

  // ---------- 활동 통계: 막대그래프 (고정 색상, 다중 선택, 연도 구분선, 호버 툴팁, 고정 막대폭) ----------
  const TAGGED_DATES: string[] = JSON.parse(document.getElementById('tagged-dates-data')?.textContent ?? '[]');

  // 검정 배경에서 확실히 잘 보이도록 테마 변수에 기대지 않고 고정 색을 씀
  const SERIES_COLORS = ['#ffffff', '#fb923c', '#facc15', '#22d3ee', '#f472b6', '#34d399'];
  const AXIS_LINE_COLOR = '#5a5a63';
  const AXIS_TEXT_COLOR = '#b8b8c0';
  const YEAR_LABEL_COLOR = '#ffffff';

  // 막대 대신 선(line chart)으로 표시. 기간 하나당 간격은 고정값 — 데이터가 많을수록 그래프 폭만 늘어남.
  const POINT_GAP = 46, CHART_H = 340, PAD_T = 40, PAD_B = 28, PAD_L = 28, PAD_R = 16;

  interface ChartPeriod {
    label: string;
    year: string;
    values: { name: string; count: number; color: string; dashed?: boolean; secondaryAxis?: boolean }[];
  }

  // 호버 감지를 각 점(circle)마다 리스너를 따로 다는 대신, wrap 하나에만 이벤트를 걸어서
  // "지금 마우스 아래에 있는 게 점인지"를 매번 판단하는 방식(이벤트 위임)으로 처리.
  // 이러면 그래프를 다시 그려도(innerHTML 교체) 매번 리스너를 새로 달 필요가 없어서 훨씬 안정적임.
  // 화면에 떠다니는 말풍선 대신, 그래프 바로 위에 원래부터 있던 안내 문단(infoEl)의 내용을 바꾸는 방식.
  // 위치 계산이 아예 필요 없어서 화면 밖으로 나가거나 다른 요소에 가려질 걱정이 없음.
  function attachChartHover(wrap: HTMLElement, infoEl: HTMLElement | null) {
    if (!infoEl) return;
    const defaultText = infoEl.textContent ?? '';
    wrap.addEventListener('mousemove', (e) => {
      const target = (e.target as Element)?.closest?.('.chart-point') as (SVGElement & { dataset: DOMStringMap }) | null;
      if (!target) {
        infoEl.textContent = defaultText;
        return;
      }
      const { label, name, count, color } = target.dataset;
      infoEl.innerHTML = `<span class="tooltip-dot" style="background:${color}"></span><strong>${name}</strong> — ${label} · <strong>${count}회</strong>`;
    });
    wrap.addEventListener('mouseleave', () => {
      infoEl.textContent = defaultText;
    });
  }

  // periods 하나당 여러 series(선)를 같이 그릴 수 있는 공용 렌더 함수.
  // mode가 'month'면: x축엔 월(1~12) 숫자만 쓰고, 연도가 바뀌는 지점에 흰 구분선 + 우측 상단에 연도 표시.
  // 지금 스크롤 위치에서 실제로 화면에 보이는 기간(period) 인덱스 범위를 계산.
  // 점 간격이 고정값(POINT_GAP)이라, 스크롤 위치를 그 간격으로 나누면 대략 몇 번째 점인지 나옴.
  function getVisibleRange(wrap: HTMLElement | null, n: number): [number, number] | null {
    if (!wrap || n === 0) return null;
    if (wrap.scrollWidth <= wrap.clientWidth) return null; // 스크롤 자체가 없으면 그냥 전체 기준 사용
    const startIdx = Math.max(0, Math.floor((wrap.scrollLeft - PAD_L) / POINT_GAP) - 1);
    const endIdx = Math.min(n - 1, Math.ceil((wrap.scrollLeft + wrap.clientWidth - PAD_L) / POINT_GAP) + 1);
    if (startIdx >= endIdx) return null;
    return [startIdx, endIdx];
  }

  // 스크롤할 때마다(약간의 지연을 두고) "지금 보이는 구간" 기준으로 y축을 다시 계산해서 그림.
  // 그래프 자체(가로 위치)는 그대로 두고, 세로 스케일만 다시 그려서 스크롤 위치가 안 튀게 함.
  function bindDynamicYScale(wrap: HTMLElement, getPeriods: () => ChartPeriod[], getMode: () => 'year' | 'month') {
    let timer: ReturnType<typeof setTimeout> | null = null;
    wrap.addEventListener('scroll', () => {
      if (timer) clearTimeout(timer);
      timer = setTimeout(() => {
        const periods = getPeriods();
        const savedScroll = wrap.scrollLeft;
        renderChart(wrap, periods, getMode(), getVisibleRange(wrap, periods.length));
        wrap.scrollLeft = savedScroll; // innerHTML을 다시 그리면서 스크롤 위치가 초기화되는 걸 방지
      }, 120);
    });
  }

  // periods 목록에서 기본축(또는 보조축) 값들만 평평하게 뽑아냄 — y축 최솟값/최댓값 계산에 사용
  function scalePeriodsFlat(periods: ChartPeriod[], secondary: boolean): number[] {
    return periods.flatMap((p) => p.values.filter((v) => !!v.secondaryAxis === secondary).map((v) => v.count));
  }

  function renderChart(
    wrap: HTMLElement | null,
    periods: ChartPeriod[],
    mode: 'year' | 'month',
    visibleRange: [number, number] | null = null
  ) {
    if (!wrap) return;
    if (periods.length === 0) { wrap.innerHTML = ''; return; }

    const n = periods.length;
    // 컨테이너의 실제 폭을 최소 기준으로 써서, 데이터가 적어도 화면 좌우 폭을 최대한 채우게 함
    // (데이터가 많아서 필요한 폭이 그거보다 크면 자연스럽게 더 넓어지고, 그때는 가로 스크롤이 생김)
    const containerW = wrap.clientWidth || 320;
    const neededW = PAD_L + PAD_R + POINT_GAP * Math.max(n - 1, 0) + 20;
    const chartW = Math.max(containerW, neededW);
    const maxSeries = Math.max(1, ...periods.map((p) => p.values.length));
    const hasSecondary = periods.some((p) => p.values.some((v) => v.secondaryAxis));
    const padRight = hasSecondary ? PAD_R + 24 : PAD_R; // 보조축 숫자 적을 공간 확보

    // 세로축 스케일 계산 대상 기간: visibleRange가 주어지면(=지금 화면에 보이는 구간) 그 구간만,
    // 아니면 전체 기간을 기준으로 최솟값/최댓값을 잡음. 이게 "스크롤하면 y축이 그 구간에 맞게 바뀌는" 핵심.
    const scalePeriods = visibleRange ? periods.slice(visibleRange[0], visibleRange[1] + 1) : periods;

    // 값 규모가 크게 다른 시리즈(예: 채널 전체 업로드)는 보조축으로 따로 분리해서 스케일을 맞춤.
    // 안 그러면 작은 값들이 큰 값 옆에서 바닥에 눌려 붙어서 잘 안 보이게 됨.
    // 선이 그래프 맨 위 끝에 딱 붙어서 답답해 보이지 않도록, 최댓값보다 살짝 여유를 두고 스케일을 잡음.
    // 왼쪽(기본축)과 오른쪽(보조축)을 따로 조절할 수 있음:
    //  - PRIMARY_AXIS_HEADROOM: 내 출연/동기평균/전체평균 선의 여유값. 1.15 = 최댓값 대비 15% 여유.
    //  - SECONDARY_AXIS_HEADROOM: "채널 전체 업로드" 선 전용 여유값. 이 값을 크게 잡을수록, 실제로는
    //    숫자가 훨씬 큰데도 그래프에서는 덜 높게(더 작아 보이게) 그려져서, 왼쪽 축이랑 높이가
    //    똑같이 맨 위까지 차오르는 "비현실적인" 느낌을 줄일 수 있음. 지금은 2.2로 잡아서
    //    "채널 전체 업로드" 선이 그래프의 대략 아래 절반 정도까지만 올라오도록 했음.
    const PRIMARY_AXIS_HEADROOM = 2.0;
    const SECONDARY_AXIS_HEADROOM = 1.0;
    const primaryVals = scalePeriodsFlat(scalePeriods, false);
    const secondaryVals = scalePeriodsFlat(scalePeriods, true);
    const primaryMinRaw = primaryVals.length ? Math.min(...primaryVals) : 0;
    const primaryMaxRaw = Math.max(1, ...primaryVals, primaryMinRaw + 1);
    const secondaryMinRaw = secondaryVals.length ? Math.min(...secondaryVals) : 0;
    const secondaryMaxRaw = Math.max(1, ...secondaryVals, secondaryMinRaw + 1);
    const primaryMax = primaryMinRaw + (primaryMaxRaw - primaryMinRaw) * PRIMARY_AXIS_HEADROOM;
    const secondaryMax = secondaryMinRaw + (secondaryMaxRaw - secondaryMinRaw) * SECONDARY_AXIS_HEADROOM;

    const xAt = (i: number) =>
      n > 1 && neededW < containerW
        ? PAD_L + 10 + (i * (chartW - PAD_L - padRight - 20)) / (n - 1) // 폭이 남으면 점 간격을 균등하게 늘림
        : PAD_L + i * POINT_GAP + 10;
    const yAt = (count: number, secondary?: boolean) => {
      const max = secondary ? secondaryMax : primaryMax;
      const min = secondary ? secondaryMinRaw : primaryMinRaw;
      const range = Math.max(max - min, 1e-6);
      return CHART_H - PAD_B - ((count - min) / range) * (CHART_H - PAD_T - PAD_B);
    };

    let svg = `<line x1="${PAD_L}" y1="${CHART_H - PAD_B}" x2="${chartW - padRight}" y2="${CHART_H - PAD_B}" stroke="${AXIS_LINE_COLOR}" stroke-width="1" />`;

    // 왼쪽(기본축) / 오른쪽(보조축) 최댓값 표시
    svg += `<text x="${PAD_L}" y="${PAD_T - 12}" text-anchor="start" font-size="10" fill="${AXIS_TEXT_COLOR}" font-family="Archivo, sans-serif">${Math.round(primaryMinRaw)} ~ ${Math.round(primaryMaxRaw)}</text>`;
    if (hasSecondary) {
      svg += `<text x="${chartW - padRight}" y="${PAD_T - 12}" text-anchor="end" font-size="10" fill="#9ca3af" font-family="Archivo, sans-serif">채널 전체(우측축) ▲ ${Math.round(secondaryMaxRaw)}</text>`;
    }

    // 연도 구분선 + 연도 라벨, x축 기간 라벨
    let lastYear: string | null = null;
    periods.forEach((p, i) => {
      const x = xAt(i);
      if (mode === 'month' && p.year !== lastYear) {
        if (lastYear !== null) {
          const divX = (x - POINT_GAP / 2).toFixed(1);
          svg += `<line x1="${divX}" y1="${PAD_T - 8}" x2="${divX}" y2="${CHART_H - PAD_B}" stroke="#ffffff" stroke-width="1" stroke-dasharray="2,3" opacity="0.6" />`;
        }
        svg += `<text x="${x.toFixed(1)}" y="${PAD_T + 4}" text-anchor="start" font-size="11" font-weight="700" fill="${YEAR_LABEL_COLOR}" font-family="Archivo, sans-serif">${p.year}</text>`;
        lastYear = p.year;
      }
      const axisLabel = mode === 'month' ? String(Number(p.label.split('-')[1])) : p.label;
      svg += `<text x="${x.toFixed(1)}" y="${CHART_H - PAD_B + 16}" text-anchor="middle" font-size="10" fill="${AXIS_TEXT_COLOR}" font-family="Archivo, sans-serif">${axisLabel}</text>`;
    });

    // 시리즈별로 선(polyline) + 각 지점에 호버용 점(circle)을 그림. 값 라벨은 따로(아래에서) 겹치지 않게 배치함.
    const labelJobs: { period: number; y: number; text: string; color: string; dashed: boolean }[] = [];

    for (let j = 0; j < maxSeries; j++) {
      const sample = periods.find((p) => p.values[j])?.values[j];
      const color = sample?.color ?? SERIES_COLORS[j % SERIES_COLORS.length];
      const dashed = !!sample?.dashed;
      const secondary = !!sample?.secondaryAxis;
      const points = periods.map((p, i) => `${xAt(i).toFixed(1)},${yAt(p.values[j]?.count ?? 0, secondary).toFixed(1)}`).join(' ');
      svg += `<polyline points="${points}" fill="none" stroke="${color}" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"${dashed ? ' stroke-dasharray="6,5"' : ''} opacity="${dashed || secondary ? 0.85 : 1}" />`;
      periods.forEach((p, i) => {
        const v = p.values[j];
        if (!v) return;
        const cx = xAt(i).toFixed(1);
        const cy = Number(yAt(v.count, secondary).toFixed(1));
        const displayVal = dashed ? v.count.toFixed(1) : String(Math.round(v.count));
        // 실제 마우스 감지 영역(안 보임, 반지름 훨씬 크게) + 눈에 보이는 작은 점(반지름 4) 이렇게 둘로 나눠서
        // 눈으로는 작은 점만 보이지만, 마우스는 훨씬 넓은 범위에서 반응하게 함
        svg += `<circle class="chart-point" data-label="${p.label}" data-name="${v.name}" data-count="${displayVal}" data-color="${color}" cx="${cx}" cy="${cy}" r="${dashed ? 7 : 11}" fill="transparent" pointer-events="all" />`;
        if (!dashed) svg += `<circle cx="${cx}" cy="${cy}" r="4" fill="${color}" pointer-events="none" />`;
        if (v.count > 0) {
          labelJobs.push({ period: i, y: cy, text: displayVal, color, dashed });
        }
      });
    }

    // 같은 기간(period) 안에서 라벨들의 실제 y위치가 서로 가까우면(겹칠 정도면) 최소 간격을 두고 밀어냄.
    // 값이 우연히 비슷해서 그래프상 거의 붙어있을 때 숫자끼리 겹치거나 점에서 동떨어져 보이는 문제를 막기 위함.
    const MIN_LABEL_GAP = 11;
    for (let i = 0; i < periods.length; i++) {
      const cx = xAt(i).toFixed(1);
      const jobsHere = labelJobs.filter((jb) => jb.period === i).sort((a, b) => a.y - b.y);
      for (let k = 1; k < jobsHere.length; k++) {
        if (jobsHere[k].y - jobsHere[k - 1].y < MIN_LABEL_GAP) {
          jobsHere[k].y = jobsHere[k - 1].y + MIN_LABEL_GAP;
        }
      }
      jobsHere.forEach((jb) => {
        svg += `<text x="${cx}" y="${(jb.y - 6).toFixed(1)}" text-anchor="middle" font-size="10" font-weight="700" fill="${jb.color}" font-family="Archivo, sans-serif" pointer-events="none" opacity="${jb.dashed ? 0.85 : 1}">${jb.text}</text>`;
      });
    }

    wrap.innerHTML = `<svg viewBox="0 0 ${chartW} ${CHART_H}" width="${chartW}" height="${CHART_H}" class="stat-chart-svg">${svg}</svg>`;
  }

  function groupDatesByPeriod(dates: string[], mode: 'year' | 'month'): ChartPeriod[] {
    const counts: Record<string, number> = {};
    for (const d of dates) {
      const key = mode === 'year' ? d.slice(0, 4) : d.slice(0, 7);
      counts[key] = (counts[key] ?? 0) + 1;
    }
    return Object.keys(counts)
      .sort((a, b) => a.localeCompare(b))
      .map((key) => ({
        label: key,
        year: key.slice(0, 4),
        values: [{ name: '출연', count: counts[key], color: SERIES_COLORS[0] }],
      }));
  }

  // 여러 시리즈(본인 출연, 동기 평균, 전체 평균 등)를 같은 기간 축에 맞춰 하나로 합침.
  // divisor가 있으면 "인원 평균"으로 나눠서 계산 (동기/전체 평균용), 없으면 그냥 개수 그대로.
  interface SeriesDef { name: string; dates: string[]; color: string; dashed?: boolean; divisor?: number; secondaryAxis?: boolean }
  function buildMultiSeriesPeriods(seriesDefs: SeriesDef[], mode: 'year' | 'month'): ChartPeriod[] {
    const allKeys = new Set<string>();
    const countsPerSeries: Record<string, Record<string, number>> = {};

    seriesDefs.forEach((s) => {
      countsPerSeries[s.name] = {};
      for (const d of s.dates) {
        const key = mode === 'year' ? d.slice(0, 4) : d.slice(0, 7);
        countsPerSeries[s.name][key] = (countsPerSeries[s.name][key] ?? 0) + 1;
        allKeys.add(key);
      }
    });

    return [...allKeys]
      .sort((a, b) => a.localeCompare(b))
      .map((key) => ({
        label: key,
        year: key.slice(0, 4),
        values: seriesDefs.map((s) => {
          const raw = countsPerSeries[s.name][key] ?? 0;
          return {
            name: s.name,
            count: s.divisor ? raw / s.divisor : raw,
            color: s.color,
            dashed: s.dashed,
            secondaryAxis: s.secondaryAxis,
          };
        }),
      }));
  }

  // ---- 출연 추이 (본인 / 동기 평균 / 전체 평균 / 채널 전체 업로드 수) ----
  const COHORT_DATES: string[] = JSON.parse(document.getElementById('cohort-dates-data')?.textContent ?? '[]');
  const OVERALL_DATES: string[] = JSON.parse(document.getElementById('overall-dates-data')?.textContent ?? '[]');
  const CHANNEL_UPLOAD_DATES: string[] = JSON.parse(document.getElementById('channel-upload-dates-data')?.textContent ?? '[]');
  const COHORT_META = JSON.parse(document.getElementById('cohort-meta-data')?.textContent ?? '{}');

  let trendMode: 'year' | 'month' = 'year';
  const trendWrap = document.getElementById('trend-chart-wrap');
  const trendLegend = document.getElementById('trend-chart-legend');
  if (trendWrap) attachChartHover(trendWrap, document.getElementById('trend-hover-info'));

  let trendPeriods: ChartPeriod[] = [];
  function renderTrendChart() {
    const seriesDefs: { name: string; dates: string[]; color: string; dashed?: boolean; divisor?: number; secondaryAxis?: boolean }[] = [
      { name: '내 출연', dates: TAGGED_DATES, color: '#ffffff' },
      { name: '채널 전체 업로드', dates: CHANNEL_UPLOAD_DATES, color: '#fb923c', secondaryAxis: true },
    ];
    if (COHORT_META.hasCohort) {
      seriesDefs.push({ name: COHORT_META.cohortLabel || '동기 평균', dates: COHORT_DATES, color: '#facc15', dashed: true, divisor: COHORT_META.cohortDivisor });
    }
    seriesDefs.push({ name: '전체 멤버 평균', dates: OVERALL_DATES, color: '#22d3ee', dashed: true, divisor: COHORT_META.overallDivisor });

    trendPeriods = buildMultiSeriesPeriods(seriesDefs, trendMode);
    renderChart(trendWrap, trendPeriods, trendMode, getVisibleRange(trendWrap, trendPeriods.length));

    if (trendLegend) {
      trendLegend.innerHTML = seriesDefs
        .map((s) => `<span class="chart-legend-item"><span class="chart-legend-dot" style="background:${s.color}"></span><span style="color:${s.color}">${s.name}</span></span>`)
        .join('');
    }
  }
  if (trendWrap) bindDynamicYScale(trendWrap, () => trendPeriods, () => trendMode);
  document.querySelectorAll<HTMLButtonElement>('#trend-toggle .stat-toggle-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#trend-toggle .stat-toggle-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      trendMode = (btn.dataset.view as 'year' | 'month') ?? 'year';
      renderTrendChart();
    });
  });
  renderTrendChart();

  // ---- 선택 통계: "출연 영상" 필터에서 그룹(또는 하위)이나 멤버를 고르면, 그 선택에 대한 시계열 그래프를 보여줌 ----
  let selectionPeriod: 'year' | 'month' = 'year';
  const selectionBlock = document.getElementById('selection-chart-block');
  const selectionWrap = document.getElementById('selection-chart-wrap');
  const selectionTitle = document.getElementById('selection-chart-title');
  if (selectionWrap) attachChartHover(selectionWrap, document.getElementById('selection-hover-info'));

  let selectionPeriods: ChartPeriod[] = [];

  function renderSelectionChart() {
    if (!selectionBlock) return;

    let targetLabel: string | null = null;
    let matched: VideoItem[] = [];

    if (activeMode === 'group' && activeGroupPath.length > 0) {
      targetLabel = activeGroupPath[activeGroupPath.length - 1];
      matched = DATA.filter((v) => v.contentType === 'video' && v.groups.some((g) => matchesPath(g, activeGroupPath)));
    } else if (activeMode === 'member' && activeMemberId) {
      targetLabel = MEMBER_MAP[activeMemberId] ?? null;
      matched = DATA.filter((v) => v.contentType === 'video' && v.members.includes(activeMemberId!));
    }

    if (!targetLabel) {
      selectionBlock.style.display = 'none';
      return;
    }
    selectionBlock.style.display = '';
    if (selectionTitle) selectionTitle.textContent = `"${targetLabel}" 통계`;

    // 같은 곡(songKey)이 여러 영상으로 올라와도 기간 하나당 1회로만 집계
    const perPeriod: Record<string, Set<string>> = {};
    for (const v of matched) {
      const key = selectionPeriod === 'year' ? v.date.slice(0, 4) : v.date.slice(0, 7);
      if (!perPeriod[key]) perPeriod[key] = new Set();
      perPeriod[key].add(v.songKey);
    }
    selectionPeriods = Object.keys(perPeriod)
      .sort((a, b) => a.localeCompare(b))
      .map((key) => ({
        label: key,
        year: key.slice(0, 4),
        values: [{ name: targetLabel!, count: perPeriod[key].size, color: '#ffffff' }],
      }));

    renderChart(selectionWrap, selectionPeriods, selectionPeriod, getVisibleRange(selectionWrap, selectionPeriods.length));

    // ---- 그룹별 선택일 때만: 이 그룹에서 실제로 누구를 몇 번/몇 %로 맡았는지 + 전체 출연 중 이 그룹 비중 ----
    const roleBreakdown = document.getElementById('role-breakdown');
    const roleShareLine = document.getElementById('role-share-line');
    const roleBars = document.getElementById('role-bars');

    if (activeMode === 'group' && roleBreakdown && roleShareLine && roleBars) {
      // 같은 곡이 여러 영상으로 올라와도 1곡으로만 세기 위해 songKey 기준으로 중복 제거
      const groupSongKeys = new Set(matched.map((v) => v.songKey));
      const allMySongKeys = new Set(DATA.filter((v) => v.contentType === 'video').map((v) => v.songKey));
      const groupShare = allMySongKeys.size > 0 ? (groupSongKeys.size / allMySongKeys.size) * 100 : 0;

      // 이 그룹 안에서, 실제로 내가 role_mapping에 맡은 걸로 기록된 인물별 횟수 (곡 단위 중복 제거)
      const roleCounts: Record<string, Set<string>> = {};
      for (const v of matched) {
        if (!v.myRole) continue;
        if (!roleCounts[v.myRole]) roleCounts[v.myRole] = new Set();
        roleCounts[v.myRole].add(v.songKey);
      }
      const roleTotal = Object.values(roleCounts).reduce((sum, set) => sum + set.size, 0);

      if (roleTotal === 0) {
        // role_mapping 데이터가 아직 없는 그룹이면 조용히 숨김 (에러 아님)
        roleBreakdown.style.display = 'none';
      } else {
        roleBreakdown.style.display = '';
        roleShareLine.innerHTML = `전체 출연(<strong>${allMySongKeys.size}곡</strong>) 중 <strong style="color:#22d3ee">${targetLabel}</strong> 담당 비중: <strong>${groupSongKeys.size}곡 (${groupShare.toFixed(1)}%)</strong>`;

        const sorted = Object.entries(roleCounts).sort((a, b) => b[1].size - a[1].size);
        const roleMax = Math.max(1, ...sorted.map(([, set]) => set.size));
        roleBars.innerHTML = sorted
          .map(([person, set]) => {
            const pct = ((set.size / roleTotal) * 100).toFixed(0);
            const widthPct = (set.size / roleMax) * 100;
            return `
              <div class="role-bar-row">
                <span class="role-bar-label">${person}</span>
                <div class="role-bar-track"><div class="role-bar-fill" style="width:${widthPct}%"></div></div>
                <span class="role-bar-value">${set.size}회 (${pct}%)</span>
              </div>`;
          })
          .join('');
      }
    } else if (roleBreakdown) {
      roleBreakdown.style.display = 'none';
    }
  }
  if (selectionWrap) bindDynamicYScale(selectionWrap, () => selectionPeriods, () => selectionPeriod);

  document.querySelectorAll<HTMLButtonElement>('#selection-period-toggle .stat-toggle-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#selection-period-toggle .stat-toggle-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      selectionPeriod = (btn.dataset.view as 'year' | 'month') ?? 'year';
      renderSelectionChart();
    });
  });

  renderSelectionChart();

