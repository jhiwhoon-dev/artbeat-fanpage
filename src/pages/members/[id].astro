---
import Layout from '../../layouts/Layout.astro';
import MemberAvatar from '../../components/MemberAvatar.astro';
import members from '../../data/members.json';
import allVideos from '../../data/videos.json';

// 빌드 타임에 members.json을 순회하며 멤버 수만큼 정적 페이지를 미리 생성합니다.
// 멤버가 3명이든 66명이든 이 코드는 그대로 두면 됩니다.
export function getStaticPaths() {
  return members.map((member) => ({
    params: { id: member.id },
    props: { member },
  }));
}

const { member } = Astro.props;
const snsLabels = {
  instagram: 'Instagram',
  youtube: 'YouTube',
  tiktok: 'TikTok',
  threads: 'Threads',
  naverclip: '네이버 클립',
  twitch: 'Twitch',
  soop: 'SOOP',
};

// 이 멤버가 tagged_members에 포함된 영상만 모아서 최신순으로 정렬
const taggedVideos = allVideos
  .filter((v) => (v.tagged_members ?? []).includes(member.id))
  .sort((a, b) => b.published_date.localeCompare(a.published_date));

// 여러 활동 기간(membership_periods)을 합산해 총 활동일수를 계산
// (공백 기간 - 탈퇴~재합류 사이 - 은 제외하고 계산)
function calcActiveDays(periods) {
  if (!periods || periods.length === 0) return 0;
  const now = new Date();
  let totalMs = 0;
  for (const p of periods) {
    const start = new Date(p.joined);
    const end = p.left ? new Date(p.left) : now;
    if (!isNaN(start) && !isNaN(end)) totalMs += Math.max(0, end - start);
  }
  return Math.floor(totalMs / 86400000);
}

const periods = member.membership_periods ?? [];
const activeDays = calcActiveDays(periods);
const anniversaryYears = Math.floor(activeDays / 365);
const isCurrentlyActive = periods.length > 0 && periods[periods.length - 1].left === null;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title={member.name}>
  <div class="wrap">
    <a class="back" href={`${base}/members`}>← 멤버 목록</a>
    <div class="avatar-wrap"><MemberAvatar member={member} size={128} /></div>
    <p class="eyebrow">{member.role} · {member.status === 'active' ? '활동 중' : member.status}</p>
    <h1>{member.name}</h1>

    {member.unit.length > 0 && (
      <p class="units">{member.unit.join(' · ')}</p>
    )}

    {member.bio && (
      <p class="bio">{member.bio}</p>
    )}

    <dl class="meta">
      <div class="meta-row"><dt>가입일</dt><dd>{member.joined_date ?? '-'}</dd></div>
      {periods.length > 1 && (
        <div class="meta-row"><dt>재합류일</dt><dd>{periods[periods.length - 1].joined}</dd></div>
      )}
      {member.status === 'withdrawn' && member.left_date && (
        <div class="meta-row"><dt>탈퇴일</dt><dd>{member.left_date}</dd></div>
      )}
    </dl>

    {activeDays > 0 && (
      <p class="tenure">
        {isCurrentlyActive
          ? <>소속일로부터 <strong>+{activeDays}일</strong>, {anniversaryYears > 0 ? `${anniversaryYears}주년` : '1주년 미만'}</>
          : <>총 활동 <strong>{activeDays}일</strong> ({anniversaryYears > 0 ? `${anniversaryYears}주년 분` : '1년 미만'})</>
        }
      </p>
    )}

    {Object.keys(member.sns).length > 0 && (
      <div class="sns">
        {Object.entries(member.sns).map(([platform, urls]) => (
          <div class="sns-group">
            <span class="platform">{snsLabels[platform] ?? platform}</span>
            {urls.map((url) => (
              <a href={url} target="_blank" rel="noopener noreferrer">바로가기 ↗</a>
            ))}
          </div>
        ))}
      </div>
    )}

    {taggedVideos.length > 0 && (
      <div class="tagged-videos">
        <h2>출연 영상 ({taggedVideos.length})</h2>
        <div class="tv-grid">
          {taggedVideos.map((v) => (
            <a class="tv-card" href={`https://www.youtube.com/watch?v=${v.youtube_id}`} target="_blank" rel="noopener noreferrer">
              <div class="tv-thumb">
                <img src={`https://img.youtube.com/vi/${v.youtube_id}/hqdefault.jpg`} alt={v.title} loading="lazy" />
              </div>
              <p>{v.title}</p>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>

<style>
  .back {
    display: inline-block;
    margin-bottom: 32px;
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
  }
  .back:hover { color: var(--accent); }
  .avatar-wrap { margin-bottom: 24px; }
  .units {
    font-size: 15px;
    color: var(--muted);
    margin: -32px 0 24px;
  }
  .bio {
    white-space: pre-line;
    line-height: 1.7;
    font-size: 16px;
    margin-bottom: 32px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    row-gap: 6px;
    column-gap: 24px;
    font-size: 14px;
    margin-bottom: 32px;
  }
  .meta-row { display: flex; gap: 6px; }
  .meta dt { color: var(--muted); }
  .meta dd { margin: 0; }
  .tenure {
    display: inline-block;
    font-size: 13px;
    color: var(--muted);
    background: var(--line);
    border-radius: 999px;
    padding: 6px 14px;
    margin-bottom: 32px;
  }
  .tenure strong { color: var(--ink); }
  .sns {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .sns-group {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 14px;
  }
  .platform {
    color: var(--muted);
    min-width: 80px;
  }
  .sns-group a {
    color: var(--accent);
    text-decoration: none;
  }
  .sns-group a:hover { text-decoration: underline; }
  .tagged-videos {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .tagged-videos h2 {
    font-size: 16px;
    margin: 0 0 20px;
  }
  .tv-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 16px;
  }
  .tv-card { text-decoration: none; color: var(--ink); }
  .tv-thumb {
    aspect-ratio: 16/9;
    border-radius: 8px;
    overflow: hidden;
    background: #1a1a1c;
  }
  .tv-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tv-card p { font-size: 12px; margin: 8px 0 0; line-height: 1.4; }
</style>
