---
import Layout from '../layouts/Layout.astro';
import MemberCard from '../components/MemberCard.astro';
import PlatformIcon from '../components/PlatformIcon.astro';
import groupInfo from '../data/artbeat_v.json';
import members from '../data/members.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// artbeat_v 필드가 있는 멤버만 골라서, 데뷔일 → 이름순으로 정렬
const artbeatVMembers = members
  .filter((m) => m.artbeat_v)
  .sort((a, b) => (a.artbeat_v.debut_date ?? '').localeCompare(b.artbeat_v.debut_date ?? ''));

// left_date가 있으면 탈퇴 멤버, 없으면 현재 활동 멤버로 구분
const activeLineup = artbeatVMembers.filter((m) => !m.artbeat_v.left_date);
const formerLineup = artbeatVMembers.filter((m) => m.artbeat_v.left_date);

const storyParagraphs = (groupInfo.story ?? '').split('\n\n').filter(Boolean);

const socialLinks = Object.entries(groupInfo.social ?? {}).filter(([, url]) => url);
const snsLabels = { instagram: 'Instagram', youtube: 'YouTube', tiktok: 'TikTok', threads: 'Threads' };
---

<Layout title="ARTBEAT v">
  <div class="wrap">
    <section class="hero">
      <p class="eyebrow">ARTBEAT PRESENTS</p>
      <h1>{groupInfo.name}</h1>
      {groupInfo.tagline && <p class="tagline">{groupInfo.tagline}</p>}
      {groupInfo.debut_date && <p class="debut">{groupInfo.debut_date} DEBUT</p>}
    </section>

    {storyParagraphs.length > 0 && (
      <section class="block">
        <h2>스토리</h2>
        {storyParagraphs.map((p) => <p class="story-p">{p}</p>)}
      </section>
    )}

    {groupInfo.concept && (
      <section class="block">
        <h2>컨셉</h2>
        <p class="story-p">{groupInfo.concept}</p>
      </section>
    )}

    <section class="block">
      <h2>멤버 ({activeLineup.length})</h2>
      {activeLineup.length > 0 ? (
        <div class="lineup-stagger">
          <div class="stagger-row">
            {activeLineup.slice(0, 2).map((m) => (
              <div class="lineup-card">
                <MemberCard member={m} />
                {m.artbeat_v.position && <span class="position-badge">{m.artbeat_v.position}</span>}
              </div>
            ))}
          </div>
          <div class="stagger-row offset">
            {activeLineup.slice(2).map((m) => (
              <div class="lineup-card">
                <MemberCard member={m} />
                {m.artbeat_v.position && <span class="position-badge">{m.artbeat_v.position}</span>}
              </div>
            ))}
          </div>
        </div>
      ) : (
        <p class="empty">아직 등록된 멤버가 없어요.</p>
      )}
    </section>

    {formerLineup.length > 0 && (
      <section class="block">
        <h2>탈퇴 멤버 ({formerLineup.length})</h2>
        <div class="lineup-grid">
          {formerLineup.map((m) => (
            <div class="lineup-card former">
              <MemberCard member={m} />
              <span class="former-badge">
                {m.artbeat_v.position ? `${m.artbeat_v.position} · ` : ''}~{m.artbeat_v.left_date}
              </span>
            </div>
          ))}
        </div>
      </section>
    )}

    {socialLinks.length > 0 && (
      <section class="block">
        <h2>SNS</h2>
        <div class="social-grid">
          {socialLinks.map(([platform, url]) => (
            <a class="social-card" href={url} target="_blank" rel="noopener noreferrer">
              <div class="social-icon"><PlatformIcon platform={platform} /></div>
              <strong>{snsLabels[platform] ?? platform.toUpperCase()}</strong>
            </a>
          ))}
        </div>
      </section>
    )}

    <div class="cta-row">
      <a class="cta-btn" href={`${base}/artbeat-v-videos`}>ARTBEAT v 영상 보러가기 →</a>
    </div>
  </div>
</Layout>

<style>
  .wrap { max-width: var(--content-width); margin: 0 auto; padding: 48px 24px 80px; }

  .hero {
    padding: 56px 0 40px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 40px;
  }
  .eyebrow { font-size: 12px; color: var(--muted); letter-spacing: 0.08em; margin: 0 0 12px; }
  .hero h1 {
    font-size: 56px;
    margin: 0 0 16px;
    color: #ffffff;
    line-height: 1;
  }
  .tagline { font-size: 18px; color: var(--ink); margin: 0 0 12px; }
  .debut { font-size: 13px; color: var(--muted); margin: 0; }

  .block { margin-bottom: 48px; }
  .block h2 { font-size: 18px; margin: 0 0 20px; }
  .story-p { font-size: 15px; line-height: 1.8; color: var(--ink); margin: 0 0 16px; white-space: pre-wrap; }

  .lineup-stagger {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .stagger-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center; /* 위 줄(2명), 아래 줄(3명) 둘 다 전체 페이지 폭 기준으로 가운데 정렬 */
    gap: 88px;
  }
  /* MemberCard가 aspect-ratio로 세로 비율을 잡는데, flex 안에서는 grid와 달리 폭을 자동으로 안 늘려줘서
     명시적으로 폭을 안 주면 카드가 0 크기로 찌그러짐(사진이 absolute라 내용으로도 크기가 안 잡힘). */
  .stagger-row .lineup-card { width: 250px; flex-shrink: 0; }

  /* 탈퇴 멤버 등 그냥 나란히 배치할 때 쓰는 일반 그리드 (기존 방식 유지) */
  .lineup-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 20px;
  }
  .lineup-card {
    position: relative;
    text-decoration: none;
    display: block;
  }
  .position-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    background: #013C81;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
  }

  .lineup-card.former { opacity: 0.55; filter: grayscale(1); }
  .lineup-card.former:hover { opacity: 0.85; }
  .former-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    background: var(--line);
    color: var(--muted);
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    white-space: nowrap;
  }

  .social-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px; }
  .social-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    text-decoration: none;
    color: var(--ink);
  }
  .social-card:hover { border-color: #013C81; }
  .social-icon {
    width: 36px; height: 36px; border-radius: 50%;
    background: var(--line);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }

  .empty { color: var(--muted); font-size: 14px; }

  .cta-row { text-align: center; margin-top: 56px; }
  .cta-btn {
    display: inline-block;
    padding: 14px 32px;
    border-radius: 999px;
    background: #013C81;
    color: #ffffff;
    font-weight: 700;
    text-decoration: none;
    font-size: 14px;
  }
</style>
