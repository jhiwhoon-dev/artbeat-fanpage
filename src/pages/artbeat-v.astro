---
import Layout from '../layouts/Layout.astro';
import MemberCard from '../components/MemberCard.astro';
import PlatformIcon from '../components/PlatformIcon.astro';
import groupInfo from '../data/artbeat_v.json';
import members from '../data/members.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// artbeat_v 필드가 있는 멤버만 골라서, 데뷔일 → 이름순으로 정렬
const lineup = members
  .filter((m) => m.artbeat_v)
  .sort((a, b) => (a.artbeat_v.debut_date ?? '').localeCompare(b.artbeat_v.debut_date ?? ''));

const storyParagraphs = (groupInfo.story ?? '').split('\n\n').filter(Boolean);

const socialLinks = Object.entries(groupInfo.social ?? {}).filter(([, url]) => url);
const snsLabels = { instagram: 'Instagram', youtube: 'YouTube', tiktok: 'TikTok', threads: 'Threads' };
---

<Layout title="ARTBEAT v">
  <div class="wrap" style={`--v-accent: ${groupInfo.color ?? '#ff3b30'};`}>
    <section class="hero">
      <p class="eyebrow">ARTBEAT PRESENTS</p>
      <h1>{groupInfo.name}</h1>
      {groupInfo.tagline && <p class="tagline">{groupInfo.tagline}</p>}
      {groupInfo.debut_date && <p class="debut">{groupInfo.debut_date} DEBUT</p>}
    </section>

    {storyParagraphs.length > 0 && (
      <section class="block">
        <h2>스토리</h2>
        {storyParagraphs.map((p) => <p class="story-p">{p}</p>)}
      </section>
    )}

    {groupInfo.concept && (
      <section class="block">
        <h2>컨셉</h2>
        <p class="story-p">{groupInfo.concept}</p>
      </section>
    )}

    <section class="block">
      <h2>멤버 ({lineup.length})</h2>
      {lineup.length > 0 ? (
        <div class="lineup-grid">
          {lineup.map((m) => (
            <a class="lineup-card" href={`${base}/members/${m.id}`}>
              <MemberCard member={m} />
              {m.artbeat_v.position && <span class="position-badge">{m.artbeat_v.position}</span>}
            </a>
          ))}
        </div>
      ) : (
        <p class="empty">아직 등록된 멤버가 없어요.</p>
      )}
    </section>

    {socialLinks.length > 0 && (
      <section class="block">
        <h2>SNS</h2>
        <div class="social-grid">
          {socialLinks.map(([platform, url]) => (
            <a class="social-card" href={url} target="_blank" rel="noopener noreferrer">
              <div class="social-icon"><PlatformIcon platform={platform} /></div>
              <strong>{snsLabels[platform] ?? platform.toUpperCase()}</strong>
            </a>
          ))}
        </div>
      </section>
    )}

    <div class="cta-row">
      <a class="cta-btn" href={`${base}/artbeat-v-videos`}>ARTBEAT v 영상 보러가기 →</a>
    </div>
  </div>
</Layout>

<style>
  .wrap { max-width: var(--content-width); margin: 0 auto; padding: 48px 24px 80px; }

  .hero {
    padding: 56px 0 40px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 40px;
  }
  .eyebrow { font-size: 12px; color: var(--muted); letter-spacing: 0.08em; margin: 0 0 12px; }
  .hero h1 {
    font-size: 56px;
    margin: 0 0 16px;
    color: var(--v-accent);
    line-height: 1;
  }
  .tagline { font-size: 18px; color: var(--ink); margin: 0 0 12px; }
  .debut { font-size: 13px; color: var(--muted); margin: 0; }

  .block { margin-bottom: 48px; }
  .block h2 { font-size: 18px; margin: 0 0 20px; }
  .story-p { font-size: 15px; line-height: 1.8; color: var(--ink); margin: 0 0 16px; white-space: pre-wrap; }

  .lineup-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 20px;
  }
  .lineup-card {
    position: relative;
    text-decoration: none;
    display: block;
  }
  .position-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    background: var(--v-accent);
    color: #0e0e10;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
  }

  .social-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px; }
  .social-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    text-decoration: none;
    color: var(--ink);
  }
  .social-card:hover { border-color: var(--v-accent); }
  .social-icon {
    width: 36px; height: 36px; border-radius: 50%;
    background: var(--line);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }

  .empty { color: var(--muted); font-size: 14px; }

  .cta-row { text-align: center; margin-top: 56px; }
  .cta-btn {
    display: inline-block;
    padding: 14px 32px;
    border-radius: 999px;
    background: var(--v-accent);
    color: #0e0e10;
    font-weight: 700;
    text-decoration: none;
    font-size: 14px;
  }
</style>
