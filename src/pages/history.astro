---
import Layout from '../layouts/Layout.astro';
import history from '../data/history.json';

// 오래된 순 -> 최신 순으로 정렬
const sorted = [...history].sort((a, b) => a.date.localeCompare(b.date));
---
<Layout title="History">
  <div class="wrap">
    <p class="eyebrow">ARTBEAT</p>
    <h1>History</h1>

    <ol class="timeline">
      {sorted.map((event) => (
        <li>
          <span class="date">{event.date}</span>
          <div class="content">
            <h2>{event.title}</h2>
            {event.description && <p>{event.description}</p>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</Layout>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--line);
  }
  .timeline li {
    position: relative;
    padding: 0 0 40px 28px;
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 4px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
  }
  .date {
    display: block;
    font-family: 'Archivo Black', sans-serif;
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .content h2 {
    font-size: 19px;
    margin: 0 0 6px;
  }
  .content p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
  }
</style>
