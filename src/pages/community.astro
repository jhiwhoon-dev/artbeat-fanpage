---
import Layout from '../layouts/Layout.astro';
import announcements from '../data/announcements.json';

const sorted = [...announcements].sort((a, b) => b.date.localeCompare(a.date));

// TODO: 아래 두 링크를 실제로 만드신 구글 폼 URL로 교체하세요.
// (하나의 폼에 "제보 유형: 버그/건의" 선택 항목을 넣고 두 버튼이 같은 폼을 가리키게 해도 됩니다.)
const BUG_REPORT_FORM_URL = 'https://forms.google.com/YOUR_BUG_REPORT_FORM';
const SUGGESTION_FORM_URL = 'https://forms.google.com/YOUR_SUGGESTION_FORM';
---
<Layout title="Community">
  <div class="wrap">
    <p class="eyebrow">ARTBEAT</p>
    <h1>Community</h1>

    <!-- 공지사항 -->
    <section class="community-section">
      <h2>공지사항</h2>
      <ul class="announcement-list">
        {sorted.map((a) => (
          <li class="notice-card">
            <span class="notice-badge">📢 NOTICE</span>
            <span class="a-date">{a.date.replaceAll('-', '.')}</span>
            <h3>{a.title}</h3>
            <p>{a.body}</p>
          </li>
        ))}
        {sorted.length === 0 && <p class="empty-note">등록된 공지사항이 없어요.</p>}
      </ul>
    </section>

    <!-- 버그 제보 / 건의 -->
    <section class="community-section">
      <h2>버그 제보 &amp; 건의</h2>
      <p class="section-desc">
        제출하신 내용은 사이트에 공개되지 않고, 운영자와 작성자 본인만 확인할 수 있어요.
      </p>
      <div class="link-cards">
        <a class="link-card" href={BUG_REPORT_FORM_URL} target="_blank" rel="noopener noreferrer">
          <strong>버그 제보</strong>
          <span>사이트에서 이상한 점을 발견하셨나요?</span>
          <span class="go">제보하기 →</span>
        </a>
        <a class="link-card" href={SUGGESTION_FORM_URL} target="_blank" rel="noopener noreferrer">
          <strong>건의하기</strong>
          <span>더 좋은 아이디어가 있으신가요?</span>
          <span class="go">건의하기 →</span>
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .community-section {
    margin-bottom: 56px;
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }
  .community-section:first-of-type { padding-top: 0; border-top: none; }
  .community-section h2 { font-size: 20px; margin: 0 0 20px; }
  .section-desc { font-size: 13px; color: var(--muted); margin: -8px 0 24px; }

  .announcement-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .notice-card {
    padding: 24px;
    border: 1px solid var(--ink);
    border-radius: 16px;
  }
  .notice-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--live);
    color: #fff;
    font-family: 'Archivo Black', sans-serif;
    font-size: 11px;
    letter-spacing: 0.05em;
    padding: 5px 12px;
    border-radius: 999px;
    margin-bottom: 12px;
  }
  .a-date { display: block; font-size: 12px; color: var(--muted); }
  .announcement-list h3 { font-size: 16px; margin: 6px 0 6px; }
  .announcement-list p { font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0; }

  .link-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }
  .link-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 8px;
    text-decoration: none;
    color: var(--ink);
  }
  .link-card:hover { border-color: var(--muted); }
  .link-card strong { font-size: 17px; }
  .link-card span { font-size: 13px; color: var(--muted); }
  .link-card .go { color: var(--ink); font-weight: 700; margin-top: 8px; }

  .empty-note { color: var(--muted); font-size: 14px; }
</style>
