---
import Layout from '../../layouts/Layout.astro';
import MemberCard from '../../components/MemberCard.astro';
import allVideos from '../../data/videos.json';
import fs from 'node:fs';
import path from 'node:path';
import members from '../../data/members.json';

export function getStaticPaths() {
  return allVideos.map((v) => ({
    params: { id: v.youtube_id },
    props: { video: v },
  }));
}

interface RoleMapping {
  member_id: string;
  covered_group: string;
  covered_member: string;
}
interface ViewSnapshot {
  date: string;
  views: number;
  likes: number;
}
interface VideoEntry {
  youtube_id: string;
  title: string;
  covered_group?: string[];
  content_series?: string[];
  tagged_members?: string[];
  special_dancers?: string[];
  role_mapping?: RoleMapping[];
  ads?: string[];
  sponsors?: string[];
  support?: string[];
  choreography?: string[];
  published_date: string;
  content_type?: string;
  view_count?: number;
  like_count?: number;
  duration_seconds?: number;
  has_captions?: boolean;
  thumbnail_url?: string | null;
  privacy_status?: string;
}

const { video } = Astro.props as { video: VideoEntry };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function getType(v: VideoEntry) {
  return v.content_type ?? 'video';
}
const TYPE_LABEL: Record<string, string> = { video: '영상', short: '쇼츠', live: '라이브' };
const TYPE_PAGE: Record<string, string> = { video: 'videos', short: 'shorts', live: 'live' };

const memberMap = Object.fromEntries(members.map((m: any) => [m.id, m]));

// 참여 멤버가 누구를 맡았는지(role_mapping) — 멤버 사진+이름과 함께 보여줌.
// role_mapping에 없지만 tagged_members에는 있는 사람(역할 특정 안 된 메인 댄서)과, special_dancers(백업)는 따로 묶음.
const roleEntries = (video.role_mapping ?? [])
  .map((rm) => ({ member: memberMap[rm.member_id], covered: rm.covered_member, group: rm.covered_group }))
  .filter((e) => e.member);
const roledIds = new Set((video.role_mapping ?? []).map((rm) => rm.member_id));
const plainMainMembers = (video.tagged_members ?? [])
  .filter((id) => !roledIds.has(id) && memberMap[id])
  .map((id) => memberMap[id]);
const specialMembers = (video.special_dancers ?? [])
  .filter((id) => memberMap[id])
  .map((id) => memberMap[id]);

// 추천 영상: 같은 그룹을 공유하면 2점, 같은 멤버가 나오면 1점 — 점수 합이 높은 순, 같으면 최신순.
const related = (allVideos as VideoEntry[])
  .filter((v) => v.youtube_id !== video.youtube_id)
  .map((v) => {
    const groupScore = (v.covered_group ?? []).some((g) => (video.covered_group ?? []).includes(g)) ? 2 : 0;
    const memberScore = (v.tagged_members ?? []).some((m) => (video.tagged_members ?? []).includes(m)) ? 1 : 0;
    return { v, score: groupScore + memberScore };
  })
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score || b.v.published_date.localeCompare(a.v.published_date))
  .slice(0, 8)
  .map((x) => x.v);

// 조회수/좋아요 기록은 videos.json이 아니라 연도별 파일(view_history_2024.json, view_history_2025.json, ...)에
// 따로 저장되어 있음(ARTBEAT v 영상은 이 기록 대상이 아님 — allVideos에 애초에 안 들어있음). 디렉터리를 뒤져서
// "view_history_"로 시작하는 파일을 전부 찾아 읽은 뒤, 이 영상 기록만 뽑아 날짜순으로 합침.
const DATA_DIR = path.join(process.cwd(), 'src', 'data');
const historyFiles = fs.existsSync(DATA_DIR)
  ? fs.readdirSync(DATA_DIR).filter((f) => /^view_history_\d{4}\.json$/.test(f))
  : [];
const history: ViewSnapshot[] = historyFiles
  .flatMap((f) => {
    const yearData = JSON.parse(fs.readFileSync(path.join(DATA_DIR, f), 'utf-8'));
    return yearData[video.youtube_id] ?? [];
  })
  .sort((a, b) => a.date.localeCompare(b.date));
const hasTrend = history.length >= 2;

// 추이 그래프 좌표 계산 (members 페이지 그래프와 같은 방식)
const CHART_W = 900, CHART_H = 200, PAD_L = 44, PAD_B = 24, PAD_T = 20, PAD_R = 12;
function buildTrendPath(key: 'views' | 'likes') {
  const vals = history.map((h) => h[key]);
  const max = Math.max(1, ...vals);
  const min = Math.min(...vals);
  const range = Math.max(1, max - min);
  return history.map((h, i) => {
    const x = PAD_L + (history.length > 1 ? (i / (history.length - 1)) * (CHART_W - PAD_L - PAD_R) : 0);
    const y = CHART_H - PAD_B - ((h[key] - min) / range) * (CHART_H - PAD_B - PAD_T);
    return { x, y, v: h[key], date: h.date };
  });
}
const viewPts = hasTrend ? buildTrendPath('views') : [];
const likePts = hasTrend ? buildTrendPath('likes') : [];
const viewPathD = viewPts.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
const likePathD = likePts.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');

function formatDuration(seconds?: number) {
  if (!seconds || seconds <= 0) return null;
  const h = Math.floor(seconds / 3600);
  const m = Math.floor((seconds % 3600) / 60);
  const s = seconds % 60;
  const mm = h > 0 ? String(m).padStart(2, '0') : String(m);
  const ss = String(s).padStart(2, '0');
  return h > 0 ? `${h}:${mm}:${ss}` : `${mm}:${ss}`;
}
const durationLabel = formatDuration(video.duration_seconds);

function displayTagPath(tag: string) {
  return tag.includes('::') ? tag.split('::').join(' · ') : tag;
}
---

<Layout title={video.title}>
  <div class="wrap">
    <a class="back-link" href={`${base}/${TYPE_PAGE[getType(video)] ?? 'videos'}`}>← {TYPE_LABEL[getType(video)] ?? '영상'} 목록으로</a>

    <div class="player-wrap">
      <iframe
        src={`https://www.youtube.com/embed/${video.youtube_id}`}
        title={video.title}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>

    <h1>{video.title}</h1>
    <p class="meta-row">
      <span class="type-badge">{TYPE_LABEL[getType(video)] ?? '영상'}</span>
      <span>{video.published_date}</span>
      <span>조회수 {(video.view_count ?? 0).toLocaleString()}회</span>
      {video.like_count ? <span>좋아요 {video.like_count.toLocaleString()}개</span> : null}
      {durationLabel && <span>길이 {durationLabel}</span>}
      <span class={video.has_captions ? 'caption-yes' : 'caption-no'}>
        {video.has_captions ? '자막 있음' : '자막 없음'}
      </span>
      {video.privacy_status === 'private' && <span class="privacy-warning">⚠️ 비공개 전환됨</span>}
      <a class="yt-link" href={`https://www.youtube.com/watch?v=${video.youtube_id}`} target="_blank" rel="noopener noreferrer">
        YouTube에서 보기 ↗
      </a>
    </p>

    <div class="tags">
      {(video.covered_group ?? []).map((g) => <span class="tag tag-group">{displayTagPath(g)}</span>)}
      {(video.content_series ?? []).map((s) => <span class="tag tag-series">{displayTagPath(s)}</span>)}
      {(video.choreography ?? [])
        .filter((id) => memberMap[id])
        .map((id) => (
          <a class="tag tag-choreo" href={`${base}/members/${id}`}>🎬 안무: {memberMap[id].nickname || memberMap[id].name}</a>
        ))}
      {(video.ads ?? []).length > 0 && <span class="tag tag-ad">유료광고 · {(video.ads ?? []).join(', ')}</span>}
      {(video.sponsors ?? []).length > 0 && <span class="tag tag-sponsor">협찬 · {(video.sponsors ?? []).join(', ')}</span>}
      {(video.support ?? []).length > 0 && <span class="tag tag-support">지원 · {(video.support ?? []).join(', ')}</span>}
    </div>

    <section class="block">
      <h2>조회수 · 좋아요 추이</h2>
      {hasTrend ? (
        <>
          <svg viewBox={`0 0 ${CHART_W} ${CHART_H}`} class="chart-svg">
            <line x1={PAD_L} y1={CHART_H - PAD_B} x2={CHART_W - PAD_R} y2={CHART_H - PAD_B} class="chart-axis" />
            <polyline points={viewPathD} fill="none" stroke="#22d3ee" stroke-width="2.5" />
            <polyline points={likePathD} fill="none" stroke="#f472b6" stroke-width="2.5" />
            <text x={PAD_L} y={CHART_H - 6} class="chart-label">{history[0]?.date}</text>
            <text x={CHART_W - PAD_R} y={CHART_H - 6} class="chart-label" text-anchor="end">{history[history.length - 1]?.date}</text>
          </svg>
          <div class="chart-legend">
            <span class="legend-item"><span class="legend-dot" style="background:#22d3ee"></span>조회수 (최근 {history[history.length-1]?.views.toLocaleString()}회)</span>
            <span class="legend-item"><span class="legend-dot" style="background:#f472b6"></span>좋아요 (최근 {history[history.length-1]?.likes.toLocaleString()}개)</span>
          </div>
        </>
      ) : (
        <p class="empty">아직 추이를 그릴 만큼 데이터가 쌓이지 않았어요. 매일 자동으로 기록되니, 며칠 뒤에 다시 확인해주세요.</p>
      )}
    </section>

    {(roleEntries.length > 0 || plainMainMembers.length > 0 || specialMembers.length > 0) && (
      <section class="block">
        <h2>참여 멤버</h2>
        {roleEntries.length > 0 && (
          <div class="role-grid">
            {roleEntries.map((e) => (
              <div class="role-card-wrap">
                <MemberCard member={e.member} />
                <span class="role-caption">담당: {e.covered} ({displayTagPath(e.group)})</span>
              </div>
            ))}
          </div>
        )}
        {plainMainMembers.length > 0 && (
          <>
            <p class="sub-label">역할 정보 없음</p>
            <div class="role-grid">
              {plainMainMembers.map((m: any) => (
                <div class="role-card-wrap"><MemberCard member={m} /></div>
              ))}
            </div>
          </>
        )}
        {specialMembers.length > 0 && (
          <>
            <p class="sub-label">백업 댄서로 참여</p>
            <div class="role-grid">
              {specialMembers.map((m: any) => (
                <div class="role-card-wrap faded"><MemberCard member={m} /></div>
              ))}
            </div>
          </>
        )}
      </section>
    )}

    {related.length > 0 && (
      <section class="block">
        <h2>추천 영상</h2>
        <div class="related-grid">
          {related.map((v) => (
            <a class="related-card" href={`${base}/videos/${v.youtube_id}`}>
              <div class="related-thumb-wrap">
                <img
                  class="related-thumb"
                  src={v.thumbnail_url || `https://img.youtube.com/vi/${v.youtube_id}/hqdefault.jpg`}
                  alt={v.title}
                  loading="lazy"
                />
              </div>
              <p class="related-title">{v.title}</p>
              <p class="related-meta">{(v.view_count ?? 0).toLocaleString()}회 · {v.published_date}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<style>
  .wrap { max-width: var(--content-width); margin: 0 auto; padding: 32px 24px 80px; }
  .back-link { font-size: 13px; color: var(--muted); text-decoration: none; }
  .back-link:hover { color: var(--ink); }

  .player-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 12px;
    overflow: hidden;
    margin: 20px 0;
  }
  .player-wrap iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  h1 { font-size: 22px; margin: 0 0 12px; line-height: 1.4; }
  .meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    font-size: 13px;
    color: var(--muted);
    margin: 0 0 20px;
  }
  .type-badge {
    background: var(--line);
    color: var(--ink);
    padding: 2px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
  }
  .yt-link { color: var(--muted); text-decoration: underline; margin-left: auto; }
  .caption-yes { color: #22c55e; }
  .caption-no { color: var(--muted); }
  .privacy-warning { color: #f59e0b; font-weight: 700; }
  .yt-link:hover { color: var(--ink); }

  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px; }
  .tag { font-size: 11px; border-radius: 4px; padding: 3px 8px; text-decoration: none; }
  .tag-group { color: var(--muted); border: 1px solid var(--line); }
  .tag-series { color: var(--ink); border: 1px solid var(--ink); }
  .tag-choreo { border: 1px dashed var(--muted); background: transparent; color: var(--muted); }
  .tag-choreo:hover { border-color: var(--ink); color: var(--ink); }
  .tag-ad { background: #f59e0b; color: #0e0e10; font-weight: 700; }
  .tag-sponsor { background: #8b5cf6; color: #ffffff; font-weight: 700; }
  .tag-support { background: #3b82f6; color: #ffffff; font-weight: 700; }

  .block { margin: 0 0 40px; padding-top: 24px; border-top: 1px solid var(--line); }
  .block h2 { font-size: 15px; margin: 0 0 16px; }
  .empty { color: var(--muted); font-size: 13px; }

  .chart-svg { width: 100%; height: auto; display: block; }
  .chart-axis { stroke: var(--line); stroke-width: 1; }
  .chart-label { font-size: 10px; fill: var(--muted); font-family: 'Archivo', sans-serif; }
  .chart-legend { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 12px; }
  .legend-item { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); }
  .legend-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }

  .sub-label { font-size: 12px; color: var(--muted); margin: 20px 0 10px; }
  .role-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 16px;
  }
  .role-card-wrap { display: flex; flex-direction: column; gap: 6px; }
  .role-card-wrap.faded { opacity: 0.55; filter: grayscale(0.6); }
  .role-caption { font-size: 11px; color: var(--muted); text-align: center; }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
  }
  .related-card { text-decoration: none; color: inherit; display: block; }
  .related-thumb-wrap { aspect-ratio: 16/9; border-radius: 8px; overflow: hidden; background: #1a1a1c; }
  .related-thumb { width: 100%; height: 100%; object-fit: cover; display: block; }
  .related-title {
    font-size: 12px;
    margin: 8px 0 2px;
    color: var(--ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .related-meta { font-size: 11px; color: var(--muted); margin: 0; }
</style>
