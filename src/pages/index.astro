---
import Layout from '../layouts/Layout.astro';
import members from '../data/members.json';
---
<Layout title="Members">
  <div class="wrap">
    <p class="eyebrow">ARTBEAT</p>
    <h1>Member<span>s</span></h1>
    <ul class="member-list">
      {members.map((m, i) => (
        <li>
          <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/members/${m.id}`}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span class="name">{m.name}</span>
          </a>
        </li>
      ))}
    </ul>
    <footer>총 {members.length}명</footer>
  </div>
</Layout>

<style>
  ul.member-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  li { border-bottom: 1px solid var(--line); }
  li a {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding: 22px 4px;
    text-decoration: none;
    color: var(--ink);
    transition: padding-left 0.15s ease, color 0.15s ease;
  }
  li a:hover, li a:focus-visible {
    padding-left: 12px;
    color: var(--accent);
  }
  li a:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .num {
    font-family: 'Archivo Black', sans-serif;
    font-size: 14px;
    color: var(--muted);
    min-width: 24px;
  }
  .name {
    font-size: clamp(22px, 4vw, 30px);
    font-weight: 700;
  }
  footer {
    margin-top: 40px;
    font-size: 13px;
    color: var(--muted);
  }
</style>
