---
import Layout from '../layouts/Layout.astro';
import allVideos from '../data/videos.json';
import members from '../data/members.json';
import contentSeriesDict from '../data/content_series.json';

function getType(v) {
  if (v.content_type) return v.content_type;
  return v.is_short ? 'short' : 'video';
}
const videos = allVideos.filter((v) => getType(v) === 'video');

// 시리즈별 제작 상태(active/paused/ended) — 최상위 단계 이름 기준으로 배지 표시에 사용
const seriesStatusMap = Object.fromEntries(contentSeriesDict.map((s) => [s.name, s.status]));

const memberMap = Object.fromEntries(members.map((m) => [m.id, m.name]));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// 카드 렌더링에 필요한 필드만 추려서 클라이언트로 넘김 (필터링/페이지네이션은 이 데이터를 기준으로 JS가 처리)
const videosData = videos.map((v) => ({
  id: v.youtube_id,
  title: v.title,
  groups: v.covered_group ?? [],
  series: v.content_series ?? [],
  members: v.tagged_members ?? [],
  sponsors: v.sponsors ?? [],
  date: v.published_date,
  views: v.view_count ?? 0,
}));

function safeJson(obj) {
  return JSON.stringify(obj).replace(/</g, '\\u003c');
}
---
<Layout title="Videos">
  <div class="wrap">
    <p class="eyebrow">ARTBEAT</p>
    <h1>Video<span>s</span></h1>

    <div class="controls-top">
      <div class="mode-tabs" id="mode-tabs">
        <button class="mode-btn active" data-mode="group">그룹별</button>
        <button class="mode-btn" data-mode="series">콘텐츠별</button>
      </div>
      <div class="controls-right">
        <input type="text" class="title-search" id="title-search" placeholder="영상 제목 검색..." />
        <select id="sort-select" class="sort-select">
          <option value="newest">최신순</option>
          <option value="oldest">오래된순</option>
          <option value="views">조회수순</option>
        </select>
      </div>
    </div>

    <!-- 그룹별 / 콘텐츠별 둘 다 같은 트리형 필터 엔진을 씀. JS가 단계별 버튼 행을 동적으로 채움 -->
    <div class="filter-panel" id="panel-group">
      <div id="group-levels"></div>
    </div>

    <div class="filter-panel" id="panel-series" style="display:none">
      <div class="series-status" id="series-status" style="display:none"></div>
      <div id="series-levels"></div>
    </div>

    <p class="count-label" id="count-label"></p>
    <div class="grid" id="grid"></div>
    <button class="load-more" id="load-more" hidden>더 보기</button>
    <p class="empty" id="empty" hidden>조건에 맞는 영상이 없어요.</p>
  </div>

  <script type="application/json" id="videos-data" set:html={safeJson(videosData)} />
  <script type="application/json" id="member-map-data" set:html={safeJson(memberMap)} />
  <script type="application/json" id="base-data" set:html={safeJson(base)} />
  <script type="application/json" id="series-status-data" set:html={safeJson(seriesStatusMap)} />
</Layout>

<script>
  interface VideoItem {
    id: string;
    title: string;
    groups: string[];
    series: string[];
    members: string[];
    sponsors: string[];
    date: string;
    views: number;
  }

  const DATA: VideoItem[] = JSON.parse(document.getElementById('videos-data')!.textContent!);
  const MEMBER_MAP: Record<string, string> = JSON.parse(document.getElementById('member-map-data')!.textContent!);
  const BASE: string = JSON.parse(document.getElementById('base-data')!.textContent!);
  const SERIES_STATUS: Record<string, string> = JSON.parse(document.getElementById('series-status-data')!.textContent!);

  const PAGE_SIZE = 30;
  let currentPage = 1;
  let activeMode: 'group' | 'series' = 'group';
  let activeGroupPath: string[] = [];
  let activeSeriesPath: string[] = [];
  let sortMode = 'newest';
  let titleQuery = '';

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] ?? c));
  }

  // "::"로 몇 단계든 이어붙인 태그를 배열로 분해 (그룹/콘텐츠 공통 규칙).
  // "::" 없이 "이름 S23" 형식(예전 방식)도 2단계로 인식.
  // 예: "BOYS PLANET::SAY YES!" -> ["BOYS PLANET", "SAY YES!"]
  //     "NCT::NCT 127" -> ["NCT", "NCT 127"]
  //     "방구석 여기서요? S23" -> ["방구석 여기서요?", "S23"]
  function splitTagLevels(tag: string): string[] {
    if (tag.includes('::')) return tag.split('::').map((s) => s.trim()).filter(Boolean);
    const m = tag.match(/^(.*?)\s*S(\d+)$/i);
    return m ? [m[1].trim(), `S${m[2]}`] : [tag];
  }

  // 태그가 현재 선택 경로(path)로 시작하는지 확인 (경로가 비어있으면 항상 매칭 = "전체")
  function matchesPath(tag: string, path: string[]): boolean {
    if (path.length === 0) return true;
    const segs = splitTagLevels(tag);
    if (segs.length < path.length) return false;
    return path.every((p, i) => segs[i] === p);
  }

  type TreeNode = Map<string, TreeNode>;

  // 영상들의 태그(그룹 또는 콘텐츠) 목록으로부터 트리를 만듦 — 깊이 제한 없이 몇 단계든 처리
  function buildTree(tagLists: string[][]): TreeNode {
    const root: TreeNode = new Map();
    for (const tags of tagLists) {
      for (const tag of tags) {
        const segs = splitTagLevels(tag);
        let node = root;
        for (const seg of segs) {
          if (!node.has(seg)) node.set(seg, new Map());
          node = node.get(seg)!;
        }
      }
    }
    return root;
  }

  const groupTree = buildTree(DATA.map((v) => v.groups));
  const seriesTree = buildTree(DATA.map((v) => v.series));

  // 트리 + 현재 선택 경로를 받아서, 선택할 때마다 하위 단계 버튼 행이 자동으로 늘어나는 UI를 그려줌.
  // 그룹/콘텐츠 둘 다 이 함수 하나를 공유해서 씀.
  function renderLevels(container: HTMLElement, tree: TreeNode, path: string[], onChange: (newPath: string[]) => void) {
    let rowsHtml = '';
    let node = tree;

    for (let depth = 0; ; depth++) {
      const keys = [...node.keys()].sort();
      if (keys.length === 0) break;

      const activeKeyAtDepth = path[depth];
      const buttons =
        `<button class="filter-btn ${activeKeyAtDepth === undefined ? 'active' : ''}" data-depth="${depth}" data-value="__all__">전체</button>` +
        keys.map((k) => `<button class="filter-btn ${k === activeKeyAtDepth ? 'active' : ''}" data-depth="${depth}" data-value="${escapeHtml(k)}">${escapeHtml(k)}</button>`).join('');
      rowsHtml += `<div class="filters series-level" data-depth="${depth}">${buttons}</div>`;

      if (!activeKeyAtDepth) break;
      node = node.get(activeKeyAtDepth)!;
    }

    container.innerHTML = rowsHtml;
    container.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const depth = Number(btn.dataset.depth);
        const value = btn.dataset.value!;
        const newPath = value === '__all__' ? path.slice(0, depth) : [...path.slice(0, depth), value];
        onChange(newPath);
      });
    });
  }

  const grid = document.getElementById('grid')!;
  const emptyEl = document.getElementById('empty')!;
  const loadMoreBtn = document.getElementById('load-more')!;
  const countLabel = document.getElementById('count-label')!;
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
  const modeButtons = document.querySelectorAll<HTMLButtonElement>('.mode-btn');
  const panelGroup = document.getElementById('panel-group');
  const panelSeries = document.getElementById('panel-series');
  const groupLevelsEl = document.getElementById('group-levels')!;
  const seriesLevelsEl = document.getElementById('series-levels')!;
  const seriesStatusEl = document.getElementById('series-status');

  const STATUS_LABEL: Record<string, string> = { active: '진행중', paused: '일시중단', ended: '종료' };

  function updateSeriesStatus() {
    if (!seriesStatusEl) return;
    const topLevel = activeSeriesPath[0];
    const status = topLevel ? SERIES_STATUS[topLevel] : undefined;
    if (!status) {
      seriesStatusEl.style.display = 'none';
      seriesStatusEl.innerHTML = '';
      return;
    }
    const cls = status === 'active' ? 'status-active' : status === 'paused' ? 'status-paused' : 'status-ended';
    seriesStatusEl.innerHTML = `<span class="status-badge ${cls}">${STATUS_LABEL[status] ?? status}</span>`;
    seriesStatusEl.style.display = '';
  }

  function renderGroupLevels() {
    renderLevels(groupLevelsEl, groupTree, activeGroupPath, (newPath) => {
      activeGroupPath = newPath;
      currentPage = 1;
      renderGroupLevels();
      render();
    });
  }

  function renderSeriesLevels() {
    renderLevels(seriesLevelsEl, seriesTree, activeSeriesPath, (newPath) => {
      activeSeriesPath = newPath;
      currentPage = 1;
      updateSeriesStatus();
      renderSeriesLevels();
      render();
    });
  }

  function displayTagPath(tag: string): string {
    return splitTagLevels(tag).join(' · ');
  }

  function cardHTML(v: VideoItem): string {
    const groupTags = v.groups.map((g) => `<span class="tag tag-group">${escapeHtml(displayTagPath(g))}</span>`).join('');
    const seriesTags = v.series.map((s) => `<span class="tag tag-series">${escapeHtml(displayTagPath(s))}</span>`).join('');
    const memberTags = v.members
      .filter((id) => MEMBER_MAP[id])
      .map((id) => `<a class="tag tag-member" href="${BASE}/members/${id}">#${escapeHtml(MEMBER_MAP[id])}</a>`)
      .join('');
    const adBadge = v.sponsors.length > 0
      ? `<span class="ad-badge">유료광고 · ${escapeHtml(v.sponsors.join(', '))}</span>`
      : '';
    return `
      <div class="card">
        <a class="thumb-link" href="https://www.youtube.com/watch?v=${v.id}" target="_blank" rel="noopener noreferrer">
          <div class="thumb-wrap">
            ${adBadge}
            <img class="thumb" src="https://img.youtube.com/vi/${v.id}/hqdefault.jpg" alt="${escapeHtml(v.title)}" loading="lazy" />
            <span class="play">▶</span>
          </div>
          <p class="title">${escapeHtml(v.title)}</p>
        </a>
        <div class="tags">${groupTags}${seriesTags}${memberTags}</div>
      </div>`;
  }

  function getFiltered(): VideoItem[] {
    return DATA.filter((v) => {
      if (titleQuery && !v.title.toLowerCase().includes(titleQuery)) return false;
      if (activeMode === 'group') {
        return v.groups.some((tag) => matchesPath(tag, activeGroupPath));
      }
      return v.series.some((tag) => matchesPath(tag, activeSeriesPath));
    });
  }

  function getSorted(list: VideoItem[]): VideoItem[] {
    const arr = [...list];
    if (sortMode === 'views') arr.sort((a, b) => b.views - a.views);
    else if (sortMode === 'oldest') arr.sort((a, b) => a.date.localeCompare(b.date));
    else arr.sort((a, b) => b.date.localeCompare(a.date));
    return arr;
  }

  function render() {
    const filtered = getSorted(getFiltered());
    const slice = filtered.slice(0, currentPage * PAGE_SIZE);

    grid.innerHTML = slice.map(cardHTML).join('');
    emptyEl.hidden = filtered.length > 0;
    loadMoreBtn.hidden = slice.length >= filtered.length;
    countLabel.textContent = filtered.length > 0 ? `총 ${filtered.length}개 중 ${slice.length}개 표시` : '';
  }

  loadMoreBtn.addEventListener('click', () => {
    currentPage++;
    render();
  });

  modeButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      modeButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeMode = (btn.dataset.mode as 'group' | 'series') ?? 'group';
      currentPage = 1;

      if (panelGroup) panelGroup.style.display = activeMode === 'group' ? '' : 'none';
      if (panelSeries) panelSeries.style.display = activeMode === 'series' ? '' : 'none';

      render();
    });
  });

  const titleSearchInput = document.getElementById('title-search') as HTMLInputElement | null;
  titleSearchInput?.addEventListener('input', () => {
    titleQuery = titleSearchInput.value.trim().toLowerCase();
    currentPage = 1;
    render();
  });

  sortSelect?.addEventListener('change', () => {
    sortMode = sortSelect.value;
    currentPage = 1;
    render();
  });

  renderGroupLevels();
  renderSeriesLevels();
  render();
</script>

<style is:global>
  .controls-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .controls-right { display: flex; align-items: center; gap: 10px; }
  .title-search {
    font-family: 'Archivo', sans-serif;
    font-size: 13px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink);
    width: 200px;
  }
  .title-search::placeholder { color: var(--muted); }
  .title-search:focus { outline: none; border-color: var(--muted); }

  .mode-tabs { display: flex; }
  .mode-btn {
    font-family: 'Archivo', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.03em;
    padding: 6px 4px;
    border: none;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .mode-btn + .mode-btn { margin-left: 20px; }
  .mode-btn.active { color: var(--ink); border-bottom-color: var(--accent); }

  .filter-panel { display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px; }

  #group-levels, #series-levels { display: flex; flex-direction: column; gap: 10px; }
  .series-level:not(:first-child) { padding-left: 20px; border-left: 2px solid var(--line); }

  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .filter-btn {
    font-family: 'Archivo', sans-serif;
    font-size: 13px;
    font-weight: 700;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .filter-btn:hover { border-color: var(--muted); color: var(--ink); }
  .filter-btn.active { background: var(--accent); border-color: var(--accent); color: #0e0e10; }

  .sort-select {
    font-family: 'Archivo', sans-serif;
    font-size: 13px;
    font-weight: 700;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink);
    cursor: pointer;
  }

  .series-status { margin: 0 0 4px; }
  .status-badge {
    display: inline-block;
    font-family: 'Archivo Black', sans-serif;
    font-size: 11px;
    letter-spacing: 0.05em;
    padding: 5px 14px;
    border-radius: 999px;
  }
  .status-active { background: #22c55e; color: #fff; }
  .status-paused { background: #ef4444; color: #fff; }
  .status-ended { background: #fff; color: #0e0e10; }

  .count-label { font-size: 12px; color: var(--muted); margin: 0 0 20px; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 20px;
  }
  .card { display: flex; flex-direction: column; }
  .thumb-link { display: block; text-decoration: none; color: var(--ink); }
  .thumb-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    overflow: hidden;
    background: #1a1a1c;
  }
  .thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.2s ease;
  }
  .thumb-link:hover .thumb { transform: scale(1.04); }
  .play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    color: #fff;
    background: rgba(0,0,0,0.15);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .thumb-link:hover .play { opacity: 1; }
  .ad-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 2;
    background: #f59e0b;
    color: #0e0e10;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 3px 8px;
    border-radius: 4px;
    white-space: nowrap;
  }
  .title {
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    margin: 10px 0 8px;
  }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag {
    font-size: 11px;
    border-radius: 4px;
    padding: 2px 6px;
    text-decoration: none;
  }
  .tag-group { color: var(--muted); border: 1px solid var(--line); }
  .tag-series { color: var(--ink); border: 1px solid var(--ink); }
  .tag-member { color: var(--ink); background: var(--line); }
  .tag-member:hover { background: var(--accent); color: #0e0e10; }

  .load-more {
    display: block;
    margin: 40px auto 0;
    padding: 12px 32px;
    font-family: 'Archivo', sans-serif;
    font-size: 13px;
    font-weight: 700;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .load-more:hover { border-color: var(--muted); }

  .empty {
    color: var(--muted);
    font-size: 14px;
    margin-top: 40px;
  }
</style>
