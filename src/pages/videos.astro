---
import Layout from '../layouts/Layout.astro';
import allVideos from '../data/videos.json';
import members from '../data/members.json';
import contentSeriesDict from '../data/content_series.json';

function getType(v) {
  if (v.content_type) return v.content_type;
  return v.is_short ? 'short' : 'video';
}
const videos = allVideos.filter((v) => getType(v) === 'video');

// 시리즈별 제작 상태(active/paused/ended) — 최상위 단계 이름 기준으로 배지 표시에 사용
const seriesStatusMap = Object.fromEntries(contentSeriesDict.map((s) => [s.name, s.status]));

const memberMap = Object.fromEntries(members.map((m) => [m.id, m.nickname || m.name]));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// 카드 렌더링에 필요한 필드만 추려서 클라이언트로 넘김 (필터링/페이지네이션은 이 데이터를 기준으로 JS가 처리)
const videosData = videos.map((v) => ({
  id: v.youtube_id,
  title: v.title,
  groups: v.covered_group ?? [],
  series: v.content_series ?? [],
  members: v.tagged_members ?? [],
  specialDancers: v.special_dancers ?? [],
  sponsors: v.sponsors ?? [], // 협찬
  ads: v.ads ?? [], // 광고
  support: v.support ?? [], // 지원
  choreography: v.choreography ?? [], // 안무가
  date: v.published_date,
  views: v.view_count ?? 0,
}));

// ---------- 연간 업로드 수 변화 그래프 (members 페이지 그래프와 같은 디자인) ----------
// 이 페이지의 타입(위에서 걸러진 videos)만 대상으로, 연도별 업로드 개수를 셈. 업로드가 0건인 해도 축에는 포함.
const YEARLY_LABEL = 'Video';
const YEARLY_COLOR = '#22d3ee';
const yearlyCounts = {};
for (const v of videos) {
  const y = String(v.published_date ?? '').slice(0, 4);
  if (/^\d{4}$/.test(y)) yearlyCounts[y] = (yearlyCounts[y] ?? 0) + 1;
}
const yearNums = Object.keys(yearlyCounts).map(Number).sort((a, b) => a - b);

// 가로축은 "ARTBEAT 설립 연도 ~ 현재 연도"를 항상 전부 보여줌 (영상이 없는 해는 0으로 표시).
// ARTBEAT_START_YEAR에 설립 연도를 숫자로 직접 넣으면(예: 2017) 그 해부터 시작하고,
// null로 두면 전체 영상(영상/쇼츠/라이브 통틀어) 중 가장 이른 업로드 연도를 설립 연도로 씀.
const ARTBEAT_START_YEAR = null;
const allUploadYears = allVideos
  .map((v) => String(v.published_date ?? '').slice(0, 4))
  .filter((y) => /^\d{4}$/.test(y))
  .map(Number);
const nowYear = new Date().getFullYear();
const foundedYear = ARTBEAT_START_YEAR ?? (allUploadYears.length > 0 ? Math.min(...allUploadYears) : nowYear);
// 혹시 설립 연도보다 이른 영상이나 미래 날짜 영상이 있어도 데이터가 잘리지 않게 범위를 넓혀줌
const rangeStartYear = Math.min(foundedYear, yearNums.length > 0 ? yearNums[0] : foundedYear);
const rangeEndYear = Math.max(nowYear, yearNums.length > 0 ? yearNums[yearNums.length - 1] : nowYear);
const chartYears = yearNums.length > 0
  ? Array.from({ length: rangeEndYear - rangeStartYear + 1 }, (_, i) => String(rangeStartYear + i))
  : [];
const yearlySeries = chartYears.map((y) => yearlyCounts[y] ?? 0);
const yearlyMax = Math.max(1, ...yearlySeries);
const currentYear = String(new Date().getFullYear());
const lastYearInProgress = chartYears.length > 0 && chartYears[chartYears.length - 1] === currentYear;

const CHART_W = 900;
const CHART_H = 220;
const PAD_L = 32;
const PAD_B = 24;
const PAD_T = 24; // 점 위에 개수 숫자를 표시할 여유 공간
const PAD_R = 12;
const X_INSET = 24; // 첫/끝 점이 왼쪽 눈금 라벨이나 오른쪽 끝에 붙지 않도록 안쪽으로 살짝 들임

function xForYear(i, total) {
  const inner = CHART_W - PAD_L - PAD_R - X_INSET * 2;
  return PAD_L + X_INSET + (total > 1 ? (i / (total - 1)) * inner : inner / 2);
}
const yearlyCoords = yearlySeries.map((c, i) => ({
  x: xForYear(i, chartYears.length),
  y: CHART_H - PAD_B - (c / yearlyMax) * (CHART_H - PAD_B - PAD_T),
}));
const yearlyPoints = yearlyCoords.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');

// 가로축에 표시할 연도 라벨 인덱스 (너무 촘촘하면 간격을 두고 표시)
function pickYearLabelIndexes(count) {
  if (count <= 1) return [0];
  const step = Math.max(1, Math.ceil(count / 10));
  const idx = [];
  for (let i = 0; i < count; i += step) idx.push(i);
  if (idx[idx.length - 1] !== count - 1) idx.push(count - 1);
  return idx;
}
const yearLabelIndexes = pickYearLabelIndexes(chartYears.length);

function safeJson(obj) {
  return JSON.stringify(obj).replace(/</g, '\\u003c');
}
---
<Layout title="Videos">
  <div class="wrap">
    <p class="eyebrow">ARTBEAT</p>
    <h1>Video<span>s</span></h1>

    {chartYears.length > 0 && (
      <div class="year-chart">
        <p class="chart-title">연간 {YEARLY_LABEL} 업로드 수 변화</p>
        <svg viewBox={`0 0 ${CHART_W} ${CHART_H}`} class="chart-svg">
          <line x1={PAD_L} y1={CHART_H - PAD_B} x2={CHART_W - PAD_R} y2={CHART_H - PAD_B} class="chart-axis" />
          <polyline points={yearlyPoints} fill="none" stroke={YEARLY_COLOR} stroke-width="2.5" />
          {yearlyCoords.map((p, i) => (
            <g>
              <circle cx={p.x} cy={p.y} r="3.5" fill={YEARLY_COLOR} />
              <text x={p.x} y={p.y - 9} class="chart-label chart-value" text-anchor="middle">{yearlySeries[i]}</text>
            </g>
          ))}
          <text x={PAD_L} y={PAD_T + 8} class="chart-label">{yearlyMax}개</text>
          <text x={PAD_L} y={CHART_H - PAD_B - 4} class="chart-label">0개</text>
          {yearLabelIndexes.map((i) => (
            <text x={xForYear(i, chartYears.length)} y={CHART_H - 6} class="chart-label" text-anchor="middle">
              {chartYears[i]}
            </text>
          ))}
        </svg>
        <div class="chart-legend">
          <span class="legend-item">
            <span class="legend-dot" style={`background:${YEARLY_COLOR}`}></span>
            {YEARLY_LABEL} <span class="legend-max">(최대 {yearlyMax}개)</span>
          </span>
          {lastYearInProgress && <span class="legend-item legend-max">※ {currentYear}년은 집계 진행 중</span>}
        </div>
      </div>
    )}

    <div class="controls-top">
      <div class="mode-tabs" id="mode-tabs">
        <button class="mode-btn active" data-mode="group">그룹별</button>
        <button class="mode-btn" data-mode="series">콘텐츠별</button>
      </div>
      <div class="controls-right">
        <input type="text" class="title-search" id="title-search" placeholder="영상 제목 검색..." />
        <select id="sort-select" class="sort-select">
          <option value="newest">최신순</option>
          <option value="oldest">오래된순</option>
          <option value="views">조회수순</option>
        </select>
      </div>
    </div>

    <!-- 그룹별 / 콘텐츠별 둘 다 같은 트리형 필터 엔진을 씀. JS가 단계별 버튼 행을 동적으로 채움 -->
    <div class="filter-panel" id="panel-group">
      <div id="group-levels"></div>
    </div>

    <div class="filter-panel" id="panel-series" style="display:none">
      <div class="series-status" id="series-status" style="display:none"></div>
      <div id="series-levels"></div>
    </div>

    <!-- 그룹/콘텐츠를 하나 선택하면, 선택한 카테고리의 연도별 업로드 수 그래프가 여기(필터와 영상 목록 사이)에 나옴. JS가 채움 -->
    <div class="year-chart selection-year-chart" id="selection-year-chart" style="display:none"></div>

    <p class="count-label" id="count-label"></p>
    <div class="grid" id="grid"></div>
    <button class="load-more" id="load-more" hidden>더 보기</button>
    <p class="empty" id="empty" hidden>조건에 맞는 영상이 없어요.</p>
  </div>

  <script type="application/json" id="videos-data" set:html={safeJson(videosData)} />
  <script type="application/json" id="member-map-data" set:html={safeJson(memberMap)} />
  <script type="application/json" id="base-data" set:html={safeJson(base)} />
  <script type="application/json" id="series-status-data" set:html={safeJson(seriesStatusMap)} />
  <script type="application/json" id="founded-year-data" set:html={safeJson(foundedYear)} />
</Layout>

<script>
  interface VideoItem {
    id: string;
    title: string;
    groups: string[];
    series: string[];
    members: string[];
    specialDancers: string[];
    sponsors: string[];
    ads: string[];
    support: string[];
    choreography: string[];
    date: string;
    views: number;
  }

  const DATA: VideoItem[] = JSON.parse(document.getElementById('videos-data')!.textContent!);
  const MEMBER_MAP: Record<string, string> = JSON.parse(document.getElementById('member-map-data')!.textContent!);
  const BASE: string = JSON.parse(document.getElementById('base-data')!.textContent!);
  const SERIES_STATUS: Record<string, string> = JSON.parse(document.getElementById('series-status-data')!.textContent!);

  const PAGE_SIZE = 30;
  let currentPage = 1;
  let activeMode: 'group' | 'series' = 'group';
  let activeGroupPath: string[] = [];
  let activeSeriesPath: string[] = [];
  // 선택 카테고리 그래프에서 점을 클릭해 고른 연도 (예: '2023'). null이면 연도 필터 없음.
  let activeYear: string | null = null;
  const currentPath = () => (activeMode === 'group' ? activeGroupPath : activeSeriesPath);
  let sortMode = 'newest';
  let titleQuery = '';

  // ---------- 필터 상태를 URL에 기록/복원 (뒤로가기 눌렀을 때 이전 필터 상태 유지) ----------
  function currentUrlWithState(): URL {
    const url = new URL(window.location.href);
    const p = url.searchParams;
    if (activeMode === 'series') p.set('mode', 'series'); else p.delete('mode');
    if (activeGroupPath.length) p.set('gpath', activeGroupPath.join('|')); else p.delete('gpath');
    if (activeSeriesPath.length) p.set('spath', activeSeriesPath.join('|')); else p.delete('spath');
    if (activeYear) p.set('year', activeYear); else p.delete('year');
    if (sortMode !== 'newest') p.set('sort', sortMode); else p.delete('sort');
    if (titleQuery) p.set('q', titleQuery); else p.delete('q');
    return url;
  }
  // 버튼 클릭처럼 "명확한 한 번의 선택"은 뒤로가기 기록에 남김
  function pushUrlState() { history.pushState(null, '', currentUrlWithState()); }
  // 검색창 타이핑처럼 계속 바뀌는 값은 기록을 안 쌓고 주소만 조용히 갱신
  function replaceUrlState() { history.replaceState(null, '', currentUrlWithState()); }

  function readUrlState() {
    const params = new URLSearchParams(window.location.search);
    return {
      mode: (params.get('mode') === 'series' ? 'series' : 'group') as 'group' | 'series',
      gpath: params.get('gpath') ? params.get('gpath')!.split('|') : [],
      spath: params.get('spath') ? params.get('spath')!.split('|') : [],
      year: params.get('year') || '',
      sort: params.get('sort') || 'newest',
      q: (params.get('q') || '').normalize('NFC'),
    };
  }

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] ?? c));
  }

  // "::"로 몇 단계든 이어붙인 태그를 배열로 분해 (그룹/콘텐츠 공통 규칙).
  // "::" 없이 "이름 S23" 형식(예전 방식)도 2단계로 인식.
  // 예: "BOYS PLANET::SAY YES!" -> ["BOYS PLANET", "SAY YES!"]
  //     "NCT::NCT 127" -> ["NCT", "NCT 127"]
  //     "방구석 여기서요? S23" -> ["방구석 여기서요?", "S23"]
  function splitTagLevels(tag: string): string[] {
    if (tag.includes('::')) return tag.split('::').map((s) => s.trim()).filter(Boolean);
    const m = tag.match(/^(.*?)\s*S(\d+)$/i);
    return m ? [m[1].trim(), `S${m[2]}`] : [tag];
  }

  // 태그가 현재 선택 경로(path)로 시작하는지 확인 (경로가 비어있으면 항상 매칭 = "전체")
  // 하위 트리를 걸을 때(렌더링용)만 쓰고, 실제 영상 필터링에는 matchesSelection을 씀.
  function matchesPath(tag: string, path: string[]): boolean {
    if (path.length === 0) return true;
    const segs = splitTagLevels(tag);
    if (segs.length < path.length) return false;
    return path.every((p, i) => segs[i] === p);
  }

  // 경로 맨 끝에 붙는 특수 값 — "자기 자신(본팀)만, 하위 유닛은 제외"를 뜻함.
  // 하위 레벨에 나오는 "자기 자신" 이름 버튼을 누르면 이 값이 붙음. 이게 안 붙어있으면 기본값은 "하위 유닛까지 포함"임.
  const EXACT_ONLY = '__exact__';

  // 실제 영상 필터링에 쓰는 매칭 함수.
  //   - 기본(아무 버튼도 더 안 누른 상태): 선택한 경로로 시작하는 태그 전부 포함 (하위 유닛 포함)
  //     예) "NCT"만 클릭 -> NCT 본팀 + NCT 127 + NCT U + NCT DREAM 영상 전부.
  //   - path 끝에 EXACT_ONLY가 붙어있으면: 정확히 그 경로와 일치하는 태그만 (하위 유닛 제외, 본팀만)
  //     예) "NCT" 클릭 후 하위 레벨에서 "NCT"(자기 자신)를 또 클릭 -> covered_group이 정확히 "NCT"인 영상만.
  function matchesSelection(tag: string, path: string[]): boolean {
    if (path.length === 0) return true;
    const exact = path[path.length - 1] === EXACT_ONLY;
    const base = exact ? path.slice(0, -1) : path;
    const segs = splitTagLevels(tag);
    if (exact) return segs.length === base.length && base.every((p, i) => segs[i] === p);
    if (segs.length < base.length) return false;
    return base.every((p, i) => segs[i] === p);
  }

  type TreeNode = Map<string, TreeNode>;

  // 영상들의 태그(그룹 또는 콘텐츠) 목록으로부터 트리를 만듦 — 깊이 제한 없이 몇 단계든 처리
  function buildTree(tagLists: string[][]): TreeNode {
    const root: TreeNode = new Map();
    for (const tags of tagLists) {
      for (const tag of tags) {
        const segs = splitTagLevels(tag);
        let node = root;
        for (const seg of segs) {
          if (!node.has(seg)) node.set(seg, new Map());
          node = node.get(seg)!;
        }
      }
    }
    return root;
  }

  const groupTree = buildTree(DATA.map((v) => v.groups));
  const seriesTree = buildTree(DATA.map((v) => v.series));

  // "기타": 탭마다 따로 판단함. 그룹별 탭의 기타 = 그룹이 비어있는 영상, 콘텐츠별 탭의 기타 = 콘텐츠가 비어있는 영상.
  // (둘 다 비어있는 영상은 두 탭의 기타에 모두 나옴.) 해당하는 영상이 하나도 없으면 그 탭의 기타 버튼은 안 보여줌.
  const ETC_VALUE = '__etc__';
  const isEtcGroup = (v: VideoItem) => v.groups.length === 0;
  const isEtcSeries = (v: VideoItem) => v.series.length === 0;
  const groupEtcButtons = DATA.some(isEtcGroup) ? [{ label: '기타', value: ETC_VALUE }] : [];
  const seriesEtcButtons = DATA.some(isEtcSeries) ? [{ label: '기타', value: ETC_VALUE }] : [];

  // 트리 + 현재 선택 경로를 받아서, 선택할 때마다 하위 단계 버튼 행이 자동으로 늘어나는 UI를 그려줌.
  // 그룹/콘텐츠 둘 다 이 함수 하나를 공유해서 씀.
  // extraButtons: 첫 단계(depth 0)에서 트리에 없는 특수 버튼(예: "기타")을 맨 끝에 추가하고 싶을 때 씀.
  function renderLevels(
    container: HTMLElement,
    tree: TreeNode,
    path: string[],
    onChange: (newPath: string[]) => void,
    extraButtons: { label: string; value: string }[] = []
  ) {
    let rowsHtml = '';
    let node = tree;
    let parentLabel: string | null = null; // 바로 윗 단계에서 선택된 이름 — 이번 단계의 "자기 자신(본팀만)" 버튼 라벨로 씀

    for (let depth = 0; ; depth++) {
      const keys = [...node.keys()].sort();
      const extras = depth === 0 ? extraButtons : [];
      if (keys.length === 0 && extras.length === 0) break;

      const activeKeyAtDepth = path[depth];
      // "전체"는 이 depth에서 아무 것도 더 선택 안 한 기본 상태(하위 유닛 포함)를 뜻함.
      // depth 0에서는 path 자체가 비어서 자연히 "진짜 전체"가 됨.
      const isAllActive = activeKeyAtDepth === undefined;
      // 하위 유닛이 있는 그룹(예: NCT)을 누르면, 처음엔 하위 유닛까지 포함해서 다 보여줌(=이 "전체"가 기본 활성 상태).
      // 그 아래 단계에서 "NCT"(자기 자신, 본팀만) 버튼을 따로 눌러야만 본팀만으로 좁혀짐.
      const selfHtml =
        depth > 0 && parentLabel !== null
          ? `<button class="filter-btn ${activeKeyAtDepth === EXACT_ONLY ? 'active' : ''}" data-depth="${depth}" data-value="__self__">${escapeHtml(parentLabel)}</button>`
          : '';
      const extraHtml = extras
        .map((eb) => `<button class="filter-btn etc-btn ${eb.value === activeKeyAtDepth ? 'active' : ''}" data-depth="${depth}" data-value="${escapeHtml(eb.value)}">${escapeHtml(eb.label)}</button>`)
        .join('');
      const buttons =
        `<button class="filter-btn ${isAllActive ? 'active' : ''}" data-depth="${depth}" data-value="__all__">전체</button>` +
        selfHtml +
        keys.map((k) => `<button class="filter-btn ${k === activeKeyAtDepth ? 'active' : ''}" data-depth="${depth}" data-value="${escapeHtml(k)}">${escapeHtml(k)}</button>`).join('') +
        extraHtml;
      rowsHtml += `<div class="filters series-level" data-depth="${depth}">${buttons}</div>`;

      // "기타"/"자기 자신(본팀만)"처럼 트리에 없는 특수 값이 선택됐거나, 주소창에 트리에 없는 값이 들어있으면 하위 단계가 없으니 여기서 멈춤
      if (!activeKeyAtDepth || activeKeyAtDepth === EXACT_ONLY || extras.some((eb) => eb.value === activeKeyAtDepth)) break;
      const next = node.get(activeKeyAtDepth);
      if (!next) break;
      parentLabel = activeKeyAtDepth;
      node = next;
    }

    container.innerHTML = rowsHtml;
    container.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const depth = Number(btn.dataset.depth);
        const value = btn.dataset.value!;
        // "전체" = 이 depth까지의 경로로 되돌림(하위 유닛 포함, 기본 상태). "자기 자신" = 거기에 EXACT_ONLY를 붙여서
        // 본팀만(하위 유닛 제외)으로 좁힘. 그 외(실제 하위 유닛 이름) = 그 경로를 한 단계 더 붙임.
        const newPath =
          value === '__all__'
            ? path.slice(0, depth)
            : value === '__self__'
              ? [...path.slice(0, depth), EXACT_ONLY]
              : [...path.slice(0, depth), value];
        onChange(newPath);
      });
    });
  }

  const grid = document.getElementById('grid')!;
  const emptyEl = document.getElementById('empty')!;
  const loadMoreBtn = document.getElementById('load-more')!;
  const countLabel = document.getElementById('count-label')!;
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
  const modeButtons = document.querySelectorAll<HTMLButtonElement>('.mode-btn');
  const panelGroup = document.getElementById('panel-group');
  const panelSeries = document.getElementById('panel-series');
  const groupLevelsEl = document.getElementById('group-levels')!;
  const seriesLevelsEl = document.getElementById('series-levels')!;
  const seriesStatusEl = document.getElementById('series-status');

  const STATUS_LABEL: Record<string, string> = { active: '진행중', paused: '일시중단', ended: '종료' };

  function updateSeriesStatus() {
    if (!seriesStatusEl) return;
    const topLevel = activeSeriesPath[0];
    const status = topLevel ? SERIES_STATUS[topLevel] : undefined;
    if (!status) {
      seriesStatusEl.style.display = 'none';
      seriesStatusEl.innerHTML = '';
      return;
    }
    const cls = status === 'active' ? 'status-active' : status === 'paused' ? 'status-paused' : 'status-ended';
    seriesStatusEl.innerHTML = `<span class="status-badge ${cls}">${STATUS_LABEL[status] ?? status}</span>`;
    seriesStatusEl.style.display = '';
  }

  function renderGroupLevels() {
    renderLevels(groupLevelsEl, groupTree, activeGroupPath, (newPath) => {
      activeGroupPath = newPath;
      activeYear = null;
      currentPage = 1;
      renderGroupLevels();
      render();
      pushUrlState();
    }, groupEtcButtons);
  }

  function renderSeriesLevels() {
    renderLevels(seriesLevelsEl, seriesTree, activeSeriesPath, (newPath) => {
      activeSeriesPath = newPath;
      activeYear = null;
      currentPage = 1;
      updateSeriesStatus();
      renderSeriesLevels();
      render();
      pushUrlState();
    }, seriesEtcButtons);
  }

  function displayTagPath(tag: string): string {
    return splitTagLevels(tag).join(' · ');
  }

  // ===== 조회수 등급별 빛 효과 — 아래 숫자들만 바꾸면 전부 조절됨 =====
  const GLOW_TIER_UNIT = 1_000_000;   // 등급 하나당 조회수 단위 (100만)
  const GLOW_MAX_TIER = 17;           // 최고 등급 (1700만 이상은 전부 이 등급으로 고정)
  const GLOW_MIN_BLUR = 9;            // 최저 등급(100만) 빛 번짐 반경 (px) — 검정 배경에서도 보이게 상향
  const GLOW_MAX_BLUR = 14;           // 최고 등급(1700만+) 빛 번짐 반경 (px)
  // 주의: 그리드 카드 간격이 20px이라, "번짐 반경 × 아래 PULSE_SCALE" 값이
  // 20px을 넘으면 옆 카드를 침범할 수 있음. 14 × 1.3 = 18.2로 여유를 둠.
  const GLOW_MIN_OPACITY = 0.45;      // 최저 등급 빛 불투명도 (0~1) — 검정 배경에서도 보이게 상향
  const GLOW_MAX_OPACITY = 0.8;       // 최고 등급 빛 불투명도 (0~1)
  const GLOW_SATURATION = 95;         // 채도 (%) — 높을수록 색이 선명함
  const GLOW_LIGHTNESS = 62;          // 명도 (%) — 검정 배경 대비를 위해 살짝 밝게 잡음
  const GLOW_START_HUE = 210;         // 최저 등급 색상(파랑, 0~360 색상환)
  const GLOW_END_HUE = 405;           // 최고 등급 색상(405 % 360 = 45, 골드)
  // 210 -> 405로 "증가하는 방향"으로 보라/핑크/빨강을 거쳐 골드로 가게 함.
  // (반대 방향으로 가면 초록/청록을 거치게 되는데, 그러면 등급이 높아질수록
  //  오히려 칙칙해 보여서 일부러 이 방향으로 잡음)
  const GLOW_PULSE_FROM_TIER = 12;    // 이 등급부터 은은하게 깜빡이는 애니메이션 켜짐 (0으로 하면 전부 깜빡임, 999로 하면 전부 고정)
  const GLOW_PULSE_DURATION = 2.4;    // 깜빡임 주기 (초). 클수록 느리고 차분함
  const GLOW_PULSE_SCALE = 1.3;       // 깜빡일 때 최대로 커지는 배율 (위 주의사항 참고)

  function computeGlow(views: number) {
    if (views < GLOW_TIER_UNIT) return null; // 100만 미만은 효과 없음
    const tier = Math.min(Math.floor(views / GLOW_TIER_UNIT), GLOW_MAX_TIER);
    const ratio = GLOW_MAX_TIER > 1 ? (tier - 1) / (GLOW_MAX_TIER - 1) : 1; // 0~1

    const hue = (GLOW_START_HUE + (GLOW_END_HUE - GLOW_START_HUE) * ratio) % 360;
    const blur = GLOW_MIN_BLUR + (GLOW_MAX_BLUR - GLOW_MIN_BLUR) * ratio;
    const opacity = GLOW_MIN_OPACITY + (GLOW_MAX_OPACITY - GLOW_MIN_OPACITY) * ratio;
    const pulse = tier >= GLOW_PULSE_FROM_TIER;

    return { tier, hue: hue.toFixed(0), blur: blur.toFixed(1), opacity: opacity.toFixed(2), pulse };
  }

  function cardHTML(v: VideoItem): string {
    const groupTags = v.groups.map((g) => `<span class="tag tag-group">${escapeHtml(displayTagPath(g))}</span>`).join('');
    const choreoTags = v.choreography
      .filter((id) => MEMBER_MAP[id])
      .map((id) => `<a class="tag tag-choreo" href="${BASE}/members/${id}">안무: ${escapeHtml(MEMBER_MAP[id])}</a>`)
      .join('');
    const seriesTags = v.series.map((s) => `<span class="tag tag-series">${escapeHtml(displayTagPath(s))}</span>`).join('');
    const memberTags = v.members
      .filter((id) => MEMBER_MAP[id])
      .map((id) => `<a class="tag tag-member" href="${BASE}/members/${id}">#${escapeHtml(MEMBER_MAP[id])}</a>`)
      .join('');
    const specialTags = v.specialDancers
      .filter((id) => MEMBER_MAP[id])
      .map((id) => `<a class="tag tag-special" href="${BASE}/members/${id}">#${escapeHtml(MEMBER_MAP[id])} <em>백업</em></a>`)
      .join('');
    // ads = 광고(유료), sponsors = 협찬(제품 협찬 등) — 서로 다른 필드로 완전히 분리
    const adBadge = v.ads.length > 0
      ? `<span class="ad-badge">유료광고 · ${escapeHtml(v.ads.join(', '))}</span>`
      : '';
    const supportBadge = v.support.length > 0
      ? `<span class="support-badge">지원 · ${escapeHtml(v.support.join(', '))}</span>`
      : '';
    const sponsorshipBadge = v.sponsors.length > 0
      ? `<span class="sponsorship-badge">협찬 · ${escapeHtml(v.sponsors.join(', '))}</span>`
      : '';
    const glow = computeGlow(v.views);
    const glowStyle = glow
      ? `--glow-hue:${glow.hue}; --glow-blur:${glow.blur}px; --glow-op:${glow.opacity}; --glow-sat:${GLOW_SATURATION}%; --glow-light:${GLOW_LIGHTNESS}%; --glow-duration:${GLOW_PULSE_DURATION}s;`
      : '';
    const glowClass = glow ? `has-glow${glow.pulse ? ' glow-pulse' : ''}` : '';
    const hotBadge = glow ? `<span class="hot-badge">🔥 인기 (${glow.tier} M)</span>` : '';
    return `
      <div class="card">
        <a class="thumb-link" href="${BASE}/videos/${v.id}">
          <div class="thumb-wrap ${glowClass}" style="${glowStyle}">
            <div class="badge-stack-tl">${adBadge}${supportBadge}</div>
            ${sponsorshipBadge}
            ${hotBadge}
            <img class="thumb" src="https://img.youtube.com/vi/${v.id}/hqdefault.jpg" alt="${escapeHtml(v.title)}" loading="lazy" />
            <span class="play">▶</span>
          </div>
          <p class="title">${escapeHtml(v.title)}</p>
        </a>
        <div class="tags">${groupTags}${seriesTags}${memberTags}${specialTags}${choreoTags}</div>
      </div>`;
  }

  function getFiltered(): VideoItem[] {
    return DATA.filter((v) => {
      if (titleQuery && !v.title.normalize('NFC').toLowerCase().includes(titleQuery)) return false;
      // 그래프에서 연도를 골랐으면(카테고리가 선택된 상태일 때만) 그 연도에 올라온 영상만 통과
      if (activeYear && currentPath().length > 0 && String(v.date ?? '').slice(0, 4) !== activeYear) return false;
      if (activeMode === 'group') {
        // 경로가 비어있으면(= "전체" 선택 상태) 태그가 하나도 없는 영상도 전부 통과시켜야 함.
        // v.groups.some(...)만 쓰면 배열이 비어있을 때 무조건 false가 나와서 "전체"인데도 걸러지는 버그가 생김.
        if (activeGroupPath.length === 0) return true;
        if (activeGroupPath[0] === ETC_VALUE) return isEtcGroup(v);
        return v.groups.some((tag) => matchesSelection(tag, activeGroupPath));
      }
      if (activeSeriesPath.length === 0) return true;
      if (activeSeriesPath[0] === ETC_VALUE) return isEtcSeries(v);
      return v.series.some((tag) => matchesSelection(tag, activeSeriesPath));
    });
  }

  function getSorted(list: VideoItem[]): VideoItem[] {
    const arr = [...list];
    if (sortMode === 'views') arr.sort((a, b) => b.views - a.views);
    else if (sortMode === 'oldest') arr.sort((a, b) => a.date.localeCompare(b.date));
    else arr.sort((a, b) => b.date.localeCompare(a.date));
    return arr;
  }

  // ---- 선택한 그룹/콘텐츠의 연도별 업로드 수 그래프 (필터 선택 영역과 영상 목록 사이) ----
  // 현재 탭(그룹별/콘텐츠별)에서 고른 경로에 해당하는 영상만 세서 연도별로 그림. (제목 검색·정렬과는 무관하게 카테고리 기준)
  // 가로축은 그 카테고리에 영상이 있는 첫 해 ~ 마지막 해이고, 중간에 영상이 없는 해도 0으로 포함함.
  const selectionChartEl = document.getElementById('selection-year-chart');
  const SEL = { W: 900, H: 220, PAD_L: 32, PAD_B: 24, PAD_T: 24, PAD_R: 12, INSET: 24, COLOR: '#a78bfa' };
  const FOUNDED_YEAR: number = JSON.parse(document.getElementById('founded-year-data')?.textContent ?? 'null') ?? new Date().getFullYear();

  // 그래프의 점(또는 "해제" 버튼)을 클릭하면 연도 필터를 켜고/끄고 목록을 다시 그림. 같은 점을 다시 누르면 해제됨.
  selectionChartEl?.addEventListener('click', (e) => {
    const target = e.target as Element;
    if (target.closest('.year-clear')) {
      activeYear = null;
    } else {
      const pt = target.closest('.year-point.clickable');
      const y = pt?.getAttribute('data-year');
      if (!y) return;
      activeYear = activeYear === y ? null : y;
    }
    currentPage = 1;
    render();
    pushUrlState();
  });

  function renderSelectionChart() {
    if (!selectionChartEl) return;
    const hide = () => {
      selectionChartEl.style.display = 'none';
      selectionChartEl.innerHTML = '';
    };

    const path = activeMode === 'group' ? activeGroupPath : activeSeriesPath;
    if (path.length === 0) return hide();

    const isEtc = path[0] === ETC_VALUE;
    const matched = DATA.filter((v) => {
      if (isEtc) return activeMode === 'group' ? isEtcGroup(v) : isEtcSeries(v);
      const tags = activeMode === 'group' ? v.groups : v.series;
      return tags.some((tag) => matchesSelection(tag, path));
    });

    const counts: Record<string, number> = {};
    for (const v of matched) {
      const y = String(v.date ?? '').slice(0, 4);
      if (/^\d{4}$/.test(y)) counts[y] = (counts[y] ?? 0) + 1;
    }
    const yearNums = Object.keys(counts).map(Number).sort((a, b) => a - b);
    if (yearNums.length === 0) return hide();

    // 가로축은 ARTBEAT 설립 연도 ~ 현재 연도를 항상 전부 보여줌 (선택한 카테고리에 영상이 없는 해는 0)
    const first = Math.min(FOUNDED_YEAR, yearNums[0]);
    const last = Math.max(new Date().getFullYear(), yearNums[yearNums.length - 1]);
    const years = Array.from({ length: last - first + 1 }, (_, i) => String(first + i));
    const series = years.map((y) => counts[y] ?? 0);
    const max = Math.max(1, ...series);
    const total = series.reduce((a, b) => a + b, 0);

    const inner = SEL.W - SEL.PAD_L - SEL.PAD_R - SEL.INSET * 2;
    const xAt = (i: number) => SEL.PAD_L + SEL.INSET + (years.length > 1 ? (i / (years.length - 1)) * inner : inner / 2);
    const coords = series.map((c, i) => ({
      x: xAt(i),
      y: SEL.H - SEL.PAD_B - (c / max) * (SEL.H - SEL.PAD_B - SEL.PAD_T),
    }));
    const pts = coords.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');

    // 가로축 연도 라벨 (너무 촘촘하면 간격을 두고 표시)
    const step = Math.max(1, Math.ceil(years.length / 10));
    const labelIdx: number[] = [];
    for (let i = 0; i < years.length; i += step) labelIdx.push(i);
    if (labelIdx[labelIdx.length - 1] !== years.length - 1) labelIdx.push(years.length - 1);

    const label = isEtc ? '기타' : path.filter((p) => p !== EXACT_ONLY).join(' · ');
    const currentYear = String(new Date().getFullYear());
    const inProgress = years[years.length - 1] === currentYear;

    selectionChartEl.innerHTML = `
      <p class="chart-title">"${escapeHtml(label)}" 연간 업로드 수 변화</p>
      <svg viewBox="0 0 ${SEL.W} ${SEL.H}" class="chart-svg">
        <line x1="${SEL.PAD_L}" y1="${SEL.H - SEL.PAD_B}" x2="${SEL.W - SEL.PAD_R}" y2="${SEL.H - SEL.PAD_B}" class="chart-axis" />
        <polyline points="${pts}" fill="none" stroke="${SEL.COLOR}" stroke-width="2.5" />
        ${coords
          .map((p, i) => {
            const yr = years[i];
            const clickable = series[i] > 0; // 영상이 0개인 해는 눌러도 목록이 비니까 클릭 불가
            const selected = activeYear === yr;
            const cx = p.x.toFixed(1);
            const cy = p.y.toFixed(1);
            return (
              `<g class="year-point${clickable ? ' clickable' : ''}${selected ? ' selected' : ''}" data-year="${yr}">` +
              (clickable ? `<title>${yr}년 · ${series[i]}개 (클릭하면 ${selected ? '연도 필터 해제' : '이 연도 영상만 보기'})</title>` : '') +
              `<circle class="pt-dot" cx="${cx}" cy="${cy}" r="${selected ? 5.5 : 3.5}" fill="${SEL.COLOR}" />` +
              (clickable ? `<circle cx="${cx}" cy="${cy}" r="12" fill="transparent" pointer-events="all" />` : '') +
              `<text x="${cx}" y="${(p.y - 9).toFixed(1)}" class="chart-label chart-value${selected ? ' chart-value-selected' : ''}" text-anchor="middle">${series[i]}</text></g>`
            );
          })
          .join('')}
        <text x="${SEL.PAD_L}" y="${SEL.PAD_T + 8}" class="chart-label">${max}개</text>
        <text x="${SEL.PAD_L}" y="${SEL.H - SEL.PAD_B - 4}" class="chart-label">0개</text>
        ${labelIdx
          .map((i) => `<text x="${xAt(i).toFixed(1)}" y="${SEL.H - 6}" class="chart-label${years[i] === activeYear ? ' chart-year-selected' : ''}" text-anchor="middle">${years[i]}</text>`)
          .join('')}
      </svg>
      <div class="chart-legend">
        <span class="legend-item">
          <span class="legend-dot" style="background:${SEL.COLOR}"></span>
          ${escapeHtml(label)} <span class="legend-max">(최대 ${max}개 · 총 ${total}개)</span>
        </span>
        ${
          activeYear
            ? `<button type="button" class="year-clear">${activeYear}년만 보는 중 · 해제 ✕</button>`
            : `<span class="legend-item legend-max">※ 점을 클릭하면 그 연도 영상만 볼 수 있어요</span>`
        }
        ${inProgress ? `<span class="legend-item legend-max">※ ${currentYear}년은 집계 진행 중</span>` : ''}
      </div>`;
    selectionChartEl.style.display = '';
  }

  function render() {
    renderSelectionChart();
    const filtered = getSorted(getFiltered());
    const slice = filtered.slice(0, currentPage * PAGE_SIZE);

    grid.innerHTML = slice.map(cardHTML).join('');
    emptyEl.hidden = filtered.length > 0;
    loadMoreBtn.hidden = slice.length >= filtered.length;
    countLabel.textContent = filtered.length > 0 ? `총 ${filtered.length}개 중 ${slice.length}개 표시` : '';
  }

  loadMoreBtn.addEventListener('click', () => {
    currentPage++;
    render();
  });

  modeButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      modeButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeMode = (btn.dataset.mode as 'group' | 'series') ?? 'group';
      activeYear = null;
      currentPage = 1;

      if (panelGroup) panelGroup.style.display = activeMode === 'group' ? '' : 'none';
      if (panelSeries) panelSeries.style.display = activeMode === 'series' ? '' : 'none';

      render();
      pushUrlState();
    });
  });

  const titleSearchInput = document.getElementById('title-search') as HTMLInputElement | null;
  titleSearchInput?.addEventListener('input', () => {
    titleQuery = titleSearchInput.value.trim().normalize('NFC').toLowerCase();
    currentPage = 1;
    render();
    replaceUrlState(); // 타이핑마다 뒤로가기 기록이 쌓이지 않도록 replace로 처리
  });

  sortSelect?.addEventListener('change', () => {
    sortMode = sortSelect.value;
    currentPage = 1;
    render();
    pushUrlState();
  });

  // 페이지가 "?mode=series&spath=..." 같은 주소로 열렸을 때(뒤로가기 포함) 그 상태로 시작
  function applyState(state: ReturnType<typeof readUrlState>) {
    activeMode = state.mode;
    activeGroupPath = state.gpath;
    activeSeriesPath = state.spath;
    // 연도 필터는 그룹/콘텐츠가 하나 선택돼 있을 때만 의미가 있음
    activeYear = /^\d{4}$/.test(state.year) && currentPath().length > 0 ? state.year : null;
    sortMode = state.sort;
    titleQuery = state.q;
    currentPage = 1;

    modeButtons.forEach((b) => b.classList.toggle('active', b.dataset.mode === activeMode));
    if (panelGroup) panelGroup.style.display = activeMode === 'group' ? '' : 'none';
    if (panelSeries) panelSeries.style.display = activeMode === 'series' ? '' : 'none';
    if (sortSelect) sortSelect.value = sortMode;
    if (titleSearchInput) titleSearchInput.value = titleQuery;

    updateSeriesStatus();
    renderGroupLevels();
    renderSeriesLevels();
    render();
  }

  // 뒤로가기/앞으로가기로 주소가 바뀌면 그 시점 상태를 다시 반영
  window.addEventListener('popstate', () => {
    applyState(readUrlState());
  });

  applyState(readUrlState());
</script>

<style is:global>
  /* 연간 업로드 수 변화 그래프 (members 페이지 그래프와 같은 디자인) */
  .year-chart { margin: 24px 0 40px; padding: 24px; border: 1px solid var(--line); border-radius: 12px; }
  .chart-title { font-size: 13px; color: var(--muted); margin: 0 0 12px; }
  .chart-svg { width: 100%; height: auto; display: block; }
  .chart-axis { stroke: var(--line); stroke-width: 1; }
  .chart-label { font-size: 10px; fill: var(--muted); font-family: 'Archivo', sans-serif; }
  .chart-value { fill: var(--ink); }
  .chart-legend { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 12px; }
  .legend-item { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); }
  .legend-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
  .legend-max { color: var(--muted); opacity: 0.7; }
  .selection-year-chart { margin: 8px 0 24px; } /* 필터 선택 영역과 영상 목록 사이에 놓이는 그래프 */
  .year-point.clickable { cursor: pointer; }
  .year-point.clickable:hover .pt-dot, .year-point.selected .pt-dot { stroke: #ffffff; stroke-width: 2; }
  .chart-value-selected, .chart-year-selected { fill: var(--ink); font-weight: 700; }
