---
interface Props {
  title: string;
}
const { title } = Astro.props;

import liveStatus from '../data/live_status.json';
import fs from 'node:fs';
import path from 'node:path';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// public/ 루트에서 파비콘 파일을 찾아주는 헬퍼 (svg > png > ico 순으로 확인)
function findFavicon() {
  const candidates = ['favicon.svg', 'favicon.png', 'favicon.ico'];
  for (const file of candidates) {
    if (fs.existsSync(path.join(process.cwd(), 'public', file))) return file;
  }
  return null;
}
const faviconFile = findFavicon();

// ARTBEAT: 소개/History를 하위로 묶은 드롭다운. Videos도 동일 패턴(Video/Shorts/Live).
const navLinks = [
  {
    label: 'ARTBEAT',
    href: base || '/',
    children: [
      { href: `${base}/about`, label: '소개' },
      { href: `${base}/history`, label: 'History' },
    ],
  },
  { href: `${base}/members`, label: 'Members' },
  {
    label: 'Videos',
    href: `${base}/videos`,
    children: [
      { href: `${base}/videos`, label: 'Video' },
      { href: `${base}/shorts`, label: 'Shorts' },
      { href: `${base}/live`, label: 'Live', live: true },
    ],
  },
  { href: `${base}/schedule`, label: 'Schedule' },
  { href: `${base}/community`, label: 'Community' },
];

// 하단 네비게이션은 드롭다운 없이 전체 페이지를 한 줄로 다 보여주는 게 더 유용해서 평탄화
const footerLinks = navLinks.flatMap((l) => (l.children ? l.children : [l]));
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — ARTBEAT</title>
  {faviconFile && <link rel="icon" href={`${base}/${faviconFile}`} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <nav class="topnav">
    <div class="topnav-inner">
      {navLinks.map((link) =>
        link.children ? (
          <div class="nav-dropdown">
            <a href={link.href} class="nav-top">
              <span class="fill-bg"></span>
              <span class="nav-content">
                {link.label}
                <span class="chevron">▾</span>
                {liveStatus.is_live && <span class="live-dot" aria-label="LIVE" />}
              </span>
            </a>
            <div class="dropdown-panel">
              {link.children.map((child) => (
                <a href={child.href}>
                  {child.label}
                  {child.live && liveStatus.is_live && <span class="live-dot" aria-label="LIVE" />}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a href={link.href} class="nav-top">
            <span class="fill-bg"></span>
            <span class="nav-content">{link.label}</span>
          </a>
        )
      )}
    </div>
  </nav>
  <slot />

  <footer class="footer-nav">
    <div class="footer-nav-inner">
      <p class="footer-brand">ARTBEAT</p>
      <nav class="footer-links">
        {footerLinks.map((link) => (
          <a href={link.href}>
            {link.label}
            {link.live && liveStatus.is_live && <span class="live-dot" aria-label="LIVE" />}
          </a>
        ))}
      </nav>
    </div>
  </footer>

  <footer class="disclaimer">
    <p>
      <strong>안내 및 면책 조항 (Disclaimer)</strong><br /><br />
      본 웹사이트는 순수한 팬심을 바탕으로 1인 개발자가 제작한 비공식 팬 페이지로, 어떠한 상업적 수익도 창출하지 않는 비영리 목적으로 운영됩니다. 본 사이트는 아티스트의 공식 소속사 및 채널과 직접적인 관련이 없습니다.<br />
      또한, 본 페이지는 YouTube의 공식 API 규정을 준수하여 영상 콘텐츠를 제공하고 있습니다. 사이트 내에서 발생하는 모든 영상 조회수 및 관련 광고 수익은 100% 원작자(공식 채널)에게 귀속되어 아티스트의 활동에 기여합니다.<br />
      시스템 오류(버그) 제보나 기타 문의 사항이 있으신 경우, 아래 이메일로 남겨주시면 감사하겠습니다. (한국어/영어 모두 가능)<br />
      문의 및 제보: <a href="mailto:kangjw0914@gmail.com">kangjw0914@gmail.com</a>
    </p>
    <hr class="disclaimer-divider" />
    <p>
      <strong>Notice &amp; Disclaimer</strong><br /><br />
      This website is an unofficial fan page created by a single developer out of pure support and admiration for the artist. It is strictly a non-profit project and does not generate any commercial revenue. This site is not affiliated with the artist's official agency or management.<br />
      Furthermore, this page operates in full compliance with the official YouTube API. All video views and ad revenue generated through this site are directed entirely to the original creator's official channel, directly supporting the artist.<br />
      If you encounter any bugs or have any inquiries, please feel free to reach out via email. (Inquiries are welcome in both English and Korean.)<br />
      Contact / Bug Report: <a href="mailto:kangjw0914@gmail.com">kangjw0914@gmail.com</a>
    </p>
  </footer>
</body>
</html>

<script>
  // 최상위 탭(.nav-top)에만 적용 — 하위 드롭다운 항목은 이 클래스가 없어서 자동으로 제외됨
  document.querySelectorAll<HTMLAnchorElement>('.nav-top').forEach((el) => {
    el.addEventListener('mouseenter', (e) => {
      const rect = el.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      el.style.setProperty('--mx', `${x}%`);
      el.style.setProperty('--my', `${y}%`);
    });
  });
</script>

<style is:global>
  :root {
    --bg: #0e0e10;
    --ink: #f4f2ee;
    --muted: #8b8a8f;
    --accent: #ffffff;
    --line: #232326;
    --live: #ff3b30;
    /* 사이트 전체 콘텐츠 폭. 이 값 하나만 바꾸면 nav/본문/disclaimer 폭이 한 번에 같이 바뀝니다. */
    --content-width: 1300px;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Archivo', sans-serif;
    min-height: 100vh;
  }
  a { color: inherit; }

  .live-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--live);
    margin-left: 6px;
    animation: live-pulse 1.4s ease-in-out infinite;
  }
  @keyframes live-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  /* 상단 네비게이션: 스크롤해도 화면에 고정 */
  .topnav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .topnav-inner {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 18px 24px;
  }
  .topnav-inner > .nav-top,
  .nav-dropdown > .nav-top {
    position: relative;
    display: inline-flex;
    align-items: center;
    overflow: hidden;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    opacity: 0.75;
    padding: 6px 10px;
    margin: -6px -10px;
    border-radius: 4px;
    transition: opacity 0.15s ease;
  }
  .topnav-inner > .nav-top:hover,
  .nav-dropdown > .nav-top:hover { opacity: 1; }

  /* 마우스가 들어온 지점을 기준으로 흰색이 박스 끝까지 퍼져나가는 효과 (최상위 탭에만 적용) */
  .fill-bg {
    position: absolute;
    inset: 0;
    background: #fff;
    clip-path: circle(0% at var(--mx, 50%) var(--my, 50%));
    transition: clip-path 0.4s ease;
    z-index: 0;
    pointer-events: none;
  }
  .nav-top:hover .fill-bg {
    clip-path: circle(140% at var(--mx, 50%) var(--my, 50%));
  }
  .nav-content {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    transition: color 0.2s ease 0.05s;
  }
  .nav-top:hover .nav-content { color: #0e0e10; }

  .nav-dropdown { position: relative; }
  .chevron { font-size: 10px; margin-left: 4px; opacity: 0.7; }

  .dropdown-panel {
    position: absolute;
    top: 100%;
    left: 0;
    padding-top: 10px; /* 트리거와 패널 사이 hover 끊김 방지용 여유 */
    min-width: 140px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s ease;
    z-index: 200;
  }
  .nav-dropdown:hover .dropdown-panel,
  .nav-dropdown:focus-within .dropdown-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .dropdown-panel > a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--ink);
    white-space: nowrap;
    background: #17171a;
    border: 1px solid var(--line);
    border-bottom: none;
  }
  .dropdown-panel > a:first-child { border-radius: 8px 8px 0 0; }
  .dropdown-panel > a:last-child { border-radius: 0 0 8px 8px; border-bottom: 1px solid var(--line); }
  .dropdown-panel > a:hover { background: var(--line); }

  .wrap {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 64px 24px;
  }
  .eyebrow {
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 12px;
  }
  h1 {
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(40px, 9vw, 72px);
    line-height: 0.95;
    margin: 0 0 48px;
    letter-spacing: -0.01em;
  }
  h1 span { color: var(--accent); }

  /* 하단 네비게이션 (빠른 이동용) */
  .footer-nav {
    border-top: 1px solid var(--line);
  }
  .footer-nav-inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 40px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .footer-brand {
    font-family: 'Archivo Black', sans-serif;
    font-size: 22px;
    margin: 0;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }
  .footer-links a {
    display: inline-flex;
    align-items: center;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
  }
  .footer-links a:hover { color: var(--ink); }

  .disclaimer {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 32px 24px 48px;
    border-top: 1px solid var(--line);
  }
  .disclaimer p {
    font-size: 12px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0 0 8px;
  }
  .disclaimer strong { color: var(--ink); }
  .disclaimer a { color: var(--muted); text-decoration: underline; }
  .disclaimer a:hover { color: var(--ink); }
  .disclaimer-divider {
    border: none;
    border-top: 1px solid var(--ink);
    margin: 24px 0;
  }
</style>
